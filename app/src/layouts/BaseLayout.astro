---
import "../styles/tailwind.css";
import Nav from "../components/Nav.astro";
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  activePage?: string;
}

const { title, activePage = "" } = Astro.props;
---

<html lang="en" class="scroll-smooth overflow-y-scroll">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      // 1. Function to get theme and apply it to the <html> element
      const applyTheme = () => {
        const theme = (() => {
          if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
            return localStorage.getItem('theme');
          }
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            return 'dark';
          }
          return 'light';
        })();
        
        // Apply the attribute to the document element
        document.documentElement.setAttribute('data-theme', theme);
      };

      // 2. Run immediately on initial page load
      applyTheme();

      // 3. Run immediately after Astro swaps the page content during navigation
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
    <slot name="head" />
  </head>

  <body class="mx-auto w-full max-w-[80ch] p-4 leading-relaxed bg-gray-100 text-stone-800 dark:bg-slate-900 dark:text-slate-200 transition-colors duration-300">
    <Nav activePage={activePage} />
    <slot />
  </body>
</html>

