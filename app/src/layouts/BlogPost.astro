---
import BaseLayout from "./BaseLayout.astro";
import "../styles/blog-post.css";

interface Image {
  url: string;
  alt: string;
}

interface Props {
  title?: string;
  description?: string;
  author?: string;
  pubDate?: string;
  image?: Image;
  tags?: string[];
}

const { title = "Sumomo - Blog Post" } = Astro.props;
---

<BaseLayout title={title}>
    <article class="blog-post">
      <header class="blog-post-header">
        <h1 class="blog-post-title">{Astro.props.title}</h1>
        <p class="blog-post-description">{Astro.props.description}</p>
        <div class="blog-post-meta">
          <span class="blog-post-author">{Astro.props.author}</span>
          {Astro.props.pubDate && (
            <span class="blog-post-date">{new Date(Astro.props.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          )}
        </div>
      </header>

      {Astro.props.image && (
        <div class="blog-post-cover">
          <img src={Astro.props.image.url} alt={Astro.props.image.alt} />
        </div>
      )}

      <div class="blog-post-content">
        <slot />
      </div>

      {Astro.props.tags && Astro.props.tags.length > 0 && (
        <footer class="blog-post-footer">
          <hr class="blog-post-divider" />
          <div class="blog-post-tags">
            {Astro.props.tags.map((tag: string) => (
              <span class="blog-post-tag">{tag}</span>
            ))}
          </div>
        </footer>
      )}
    </article>
</BaseLayout>
