---
import type { Frontmatter } from "../types/frontmatter";
import BaseLayout from "./BaseLayout.astro";

const postProps: Frontmatter = Astro.props.frontmatter;
---

<BaseLayout title={postProps.title ?? "Sumomo Blog"}>
    <header class="mb-8">
      <h1 class="text-6xl mt-10 font-bold text-stone-800 text-center dark:text-slate-100 my-0 mb-4 leading-tight transition-colors duration-300">{postProps.title}</h1>
      <p class="text-lg text-stone-500 dark:text-slate-400 my-0 mb-4 leading-relaxed italic transition-colors duration-300">{postProps.description}</p>
      {postProps.image && (
        <div class="my-6 -mx-8 md:-mx-6 overflow-hidden">
          <img src={postProps.image?.url} alt={postProps.image?.alt} class="w-full h-auto block" />
        </div>
      )}
      <div class="flex gap-4 text-sm text-stone-500 dark:text-slate-400 transition-colors duration-300">
        <span class="font-semibold text-stone-800 dark:text-slate-100 transition-colors duration-300">{postProps.author}</span>
        {postProps.pubDate && (
          <span>{new Date(postProps.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        )}
      </div>
    </header>
    <article class="border-r-4 border-stone-200 dark:border-stone-800 max-w-75ch p-8 bg-white dark:bg-slate-800 rounded-lg shadow-md theme-ready transition-[background-color,box-shadow,border-color] duration-300">
      <div class="prose prose-stone dark:prose-invert prose-green max-w-none">
        <slot />
      </div>

      {postProps.tags && postProps.tags.length > 0 && (
        <footer class="mt-8">
          <hr class="border-none border-t border-stone-200 dark:border-slate-700 my-8 mb-6 transition-[border-color] duration-300" />
          <div class="flex flex-wrap gap-2">
            {postProps.tags.map((tag: string) => (
              <span class="inline-block px-3 py-1.5 bg-gray-100 dark:bg-slate-700 text-stone-500 dark:text-slate-300 rounded-full text-sm font-medium hover:bg-stone-200 dark:hover:bg-slate-600 transition-[background-color,color] duration-200">{tag}</span>
            ))}
          </div>
        </footer>
      )}
    </article>

</BaseLayout>
