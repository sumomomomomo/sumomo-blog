---
interface Props {
  activePage?: string;
}

const { activePage = "" } = Astro.props;

const links = [
  { label: "Home", href: "/", active: "/" },
  { label: "About", href: "/about/", active: "/about/" },
  { label: "Blog", href: "/blog/", active: "/blog/" },
  { label: "TTS", href: "/tts/", active: "/tts/" },
];
---

<nav class="relative flex items-center justify-left md:justify-center gap-6 p-4 bg-white dark:bg-slate-800 border-b border-stone-200 dark:border-slate-700 theme-ready transition-[background-color,border-color] duration-300 nav-responsive">
  {links.map((link) => {
    const isActive = activePage === link.active;
    return (
      <a
        href={link.href}
        class="flex text-stone-800 dark:text-slate-300 text-sm font-medium no-underline hover:text-green-700 dark:hover:text-green-400 transition-colors duration-200"
        {...(isActive ? { class: "active text-green-700 dark:text-green-400" } : {})}
      >{link.label}</a>
    );
  })}
  <button id="theme-toggle" class="absolute right-0 bg-transparent border-none cursor-pointer p-0 w-10 h-10 rounded-full flex items-center justify-center mx-3 hover:bg-stone-200 dark:hover:bg-slate-700 transition-colors duration-300" aria-label="Toggle dark mode">
    <!-- Sun Icon -->
    <svg class="theme-icon sun-icon absolute w-5 h-5 text-stone-800 dark:text-slate-100" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="5"/>
      <line x1="12" y1="1" x2="12" y2="3"/>
      <line x1="12" y1="21" x2="12" y2="23"/>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
      <line x1="1" y1="12" x2="3" y2="12"/>
      <line x1="21" y1="12" x2="23" y2="12"/>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
    </svg>
    <!-- Moon Icon -->
    <svg class="theme-icon moon-icon absolute w-5 h-5 text-stone-800 dark:text-slate-100" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    </svg>
  </button>
</nav>

<script>
  // This event fires on initial load AND every client-side navigation
  document.addEventListener('astro:page-load', () => {
    
    const toggleBtn = document.getElementById('theme-toggle');
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    }
  });

  // System preference listener can stay at the window level safely
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (!localStorage.getItem('theme')) {
      document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
    }
  });
</script>