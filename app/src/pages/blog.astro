---
import "../styles/global.css";
import Nav from "../components/Nav.astro";

interface Props {
  title?: string;
}

const { title = "Sumomo - Blog" } = Astro.props;

interface PostModule {
  id: string;
  metadata: {
    title: string;
  };
}

const postsRaw = import.meta.glob("./posts/*.md", { eager: true });

const posts: PostModule[] = Object.entries(postsRaw).map(([path, mod]) => {
  const fileName = path.split("/").pop()?.replace(/\.md$/, "") ?? "";
  const moduleData = mod as { metadata?: { title: string } };
  return {
    id: `posts/${fileName}`,
    metadata: moduleData.metadata ?? { title: fileName },
  };
});
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>
	<body>
        <Nav activePage="/blog/" />
		
		<h1>Blog</h1>
        <ul>
            {posts.map((post) => (
                <li><a href={`/${post.id}`}>{post.metadata.title}</a></li>
            ))}
        </ul>
	</body>
</html>