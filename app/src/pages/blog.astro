---
import BaseLayout from "../layouts/BaseLayout.astro";

interface PostModule {
  id: string;
  metadata: {
    title: string;
  };
}

const postsRaw = import.meta.glob("./posts/*.md", { eager: true });

const posts: PostModule[] = Object.entries(postsRaw).map(([path, mod]) => {
  const fileName = path.split("/").pop()?.replace(/\.md$/, "") ?? "";
  const moduleData = mod as { metadata?: { title: string } };
  return {
    id: `posts/${fileName}`,
    metadata: moduleData.metadata ?? { title: fileName },
  };
});
---

<BaseLayout title="Sumomo - Blog" activePage="/blog/">
	<h1>Blog</h1>
        <ul>
            {posts.map((post) => (
                <li><a href={`/${post.id}`}>{post.metadata.title}</a></li>
            ))}
        </ul>
</BaseLayout>