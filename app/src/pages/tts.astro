---
import "../styles/global.css";
import "../styles/tts.css";
import Nav from "../components/Nav.astro";
import TTS from "../components/TTS";

interface Props {
  title?: string;
}

const { title = "TTS - Text to Speech" } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>
	<body>
        <Nav activePage="/tts/" />

        <TTS client:load />
	</body>
</html>
