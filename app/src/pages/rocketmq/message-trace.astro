---
// Replace app/src/pages/rocketmq/message-trace.astro. No additional dependencies.
import BaseLayout from "../../layouts/BaseLayout.astro";

const panel =
  "rounded-xl border border-stone-300 bg-white p-4 dark:border-slate-600 dark:bg-slate-800";
const button =
  "rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm font-semibold hover:bg-sky-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-600 dark:bg-slate-800 dark:hover:bg-slate-700";
const primary = `${button} border-sky-600 text-sky-800 dark:text-sky-300`;
const groups = [
  { id: "A", name: "fulfillment" },
  { id: "B", name: "analytics" },
];
---

<BaseLayout title="RocketMQ · Receive, process, acknowledge" activePage="">
  <main id="mq-message-trace" class="mx-auto max-w-6xl py-5">
    <header class="mb-4">
      <a href="/rocketmq/" class="text-sm text-sky-700 underline dark:text-sky-300">All RocketMQ demos</a>
      <h1 class="mt-2 text-2xl font-bold sm:text-3xl">One stored stream, two independent groups</h1>
      <p class="mt-2 text-sm text-stone-600 dark:text-slate-300">RocketMQ 5.x SimpleConsumer · normal messages · message-based delivery. Receive, process, and acknowledge are separate operations.</p>
    </header>

    <section aria-label="Simulation controls" class="sticky top-0 z-10 mb-3 rounded-xl border border-sky-300 bg-sky-50 p-3 shadow-sm dark:border-sky-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-2">
        <button type="button" data-action="publish" class={primary}>Publish message</button>
        <button type="button" data-action="time" class={button}>Advance 5 seconds</button>
        <button type="button" data-action="undo" class={button} disabled>Previous step</button>
        <button type="button" data-action="reset" class={button}>Reset</button>
        <output id="trace-clock" class="ml-auto font-mono text-sm" aria-label="Simulated time">t = 0 s</output>
      </div>
      <p id="trace-event" role="status" aria-live="polite" class="mt-2 text-sm font-medium">Try Receive A before publishing. Its request will wait at the broker.</p>
    </section>

    <div class="grid items-start gap-3 lg:grid-cols-3">
      <section class={panel} aria-labelledby="trace-broker-heading">
        <h2 id="trace-broker-heading" class="font-bold">Producer → broker</h2>
        <p id="producer-receipt" class="mt-2 rounded-lg bg-stone-100 p-2 text-sm dark:bg-slate-900">No send yet.</p>
        <h3 class="mt-4 text-sm font-bold">Topic orders · queue Q1</h3>
        <p class="mt-1 text-xs text-stone-600 dark:text-slate-300">Storage positions are offsets. A group's acknowledgement does not remove this stored record.</p>
        <ol id="trace-queue" aria-label="Stored messages" class="mt-3 space-y-2"><li class="text-sm">Queue empty.</li></ol>
        <p class="mt-3 text-xs text-stone-600 dark:text-slate-300">One queue is shown. There is one consumer in each group; neither owns this queue exclusively.</p>
      </section>

      {groups.map(({ id, name }) => (
        <section class={panel} aria-labelledby={`trace-heading-${id}`}>
          <h2 id={`trace-heading-${id}`} class="font-bold">Group {id} · {name}</h2>
          <p class="mt-1 text-xs text-stone-600 dark:text-slate-300">Consumer {id}1 · subscription: orders / all tags</p>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <button type="button" class={primary} data-action="receive" data-group={id}>Receive {id}</button>
            <button type="button" class={button} data-action="process" data-group={id} disabled>Process {id}</button>
            <button type="button" class={button} data-action="ack" data-group={id} disabled>ACK {id}</button>
            <button type="button" class={button} data-action="fail" data-group={id} disabled>Fail processing {id}</button>
          </div>
          <p id={`trace-flow-${id}`} class="mt-3 min-h-16 rounded-lg border border-sky-200 bg-sky-50 p-2 text-sm dark:border-sky-900 dark:bg-sky-950/30">No receive request.</p>
          <div id={`trace-delivery-${id}`} class="mt-3 min-h-24 rounded-lg border border-stone-300 p-3 text-sm dark:border-slate-600">No message in flight.</div>
          <p id={`trace-progress-${id}`} class="mt-3 text-sm font-semibold">Acknowledged: none</p>
          <p id={`trace-ready-${id}`} class="mt-1 text-xs text-stone-600 dark:text-slate-300">Ready: none</p>
        </section>
      ))}
    </div>

    <details open class="mt-3 rounded-xl border border-stone-300 p-4 text-sm dark:border-slate-600">
      <summary class="cursor-pointer font-semibold">Three experiments</summary>
      <ol class="mt-2 list-decimal space-y-1 pl-5">
        <li>Receive A on an empty queue, then publish. Watch the waiting request receive a response.</li>
        <li>Publish three messages. Complete Receive → Process → ACK in B while leaving A untouched.</li>
        <li>Process A but do not ACK. Advance time to its deadline, receive again, and observe the same message with a higher delivery attempt.</li>
      </ol>
      <p class="mt-3">Business processing and broker acknowledgement are different events. A message can be processed again after an acknowledgement is lost or a consumer times out; business handlers need to tolerate redelivery.</p>
    </details>
    <details class="mt-3 rounded-xl border border-stone-300 p-4 text-sm dark:border-slate-600">
      <summary class="cursor-pointer font-semibold">Scope and sources</summary>
      <p class="mt-2">This is a logical simulation, not a connected broker. Time advances only when clicked. Receive waits up to 20 simulated seconds; delivery is invisible to other consumers in the same group for 10 seconds. Other groups remain independent. Failure sends no ACK; after invisibility expires the message becomes eligible for another receive.</p>
      <p class="mt-2">For clarity, each group holds at most one delivery and the earliest eligible message is selected. These are demo choices, not RocketMQ concurrency or ordering guarantees. Broker persistence, network failures, message retention, retry limits, and dead-letter queues are omitted. No queue-offset commit model is implied by the acknowledgement list.</p>
      <p class="mt-2">Compare <a class="text-sky-700 underline dark:text-sky-300" href="/rocketmq/consumer-rebalancing/">load-balancing models</a>. Sources: <a class="text-sky-700 underline dark:text-sky-300" href="https://rocketmq.apache.org/docs/featureBehavior/06consumertype/">consumer types</a>, <a class="text-sky-700 underline dark:text-sky-300" href="https://rocketmq.apache.org/docs/featureBehavior/10consumerretrypolicy/">retries</a>, <a class="text-sky-700 underline dark:text-sky-300" href="https://rocketmq.apache.org/docs/featureBehavior/08consumerloadbalance/">load balancing</a>.</p>
    </details>
    <noscript><p class="mt-4">Enable JavaScript to run the simulation.</p></noscript>
  </main>
</BaseLayout>

<script>
  function setupMessageTrace() {
    const root = document.querySelector<HTMLElement>("#mq-message-trace");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "true";
    type GroupId = "A" | "B";
    type Delivery = { id: number; deadline: number; outcome: "pending" | "processed" | "failed"; attempt: number };
    type Group = { requestUntil: number | null; delivery: Delivery | null; acked: number[]; attempts: Record<number, number>; flow: string };
    type State = { time: number; messages: number[]; groups: Record<GroupId, Group>; event: string; receipt: string };
    const initialGroup = (): Group => ({ requestUntil: null, delivery: null, acked: [], attempts: {}, flow: "No receive request." });
    const initial = (): State => ({ time: 0, messages: [], groups: { A: initialGroup(), B: initialGroup() }, event: "Try Receive A before publishing. Its request will wait at the broker.", receipt: "No send yet." });
    let state = initial();
    const history: State[] = [];
    const ids: GroupId[] = ["A", "B"];
    const find = <T extends Element>(selector: string) => root.querySelector<T>(selector)!;
    const put = (selector: string, text: string) => { find<HTMLElement>(selector).textContent = text; };
    const messageName = (id: number) => `M-${104 + id}`;
    const available = (g: Group) => state.messages.filter(id => !g.acked.includes(id) && g.delivery?.id !== id);

    function deliver(id: GroupId) {
      const g = state.groups[id];
      const message = available(g)[0];
      if (message === undefined) return false;
      const attempt = (g.attempts[message] ?? 0) + 1;
      g.attempts[message] = attempt;
      g.delivery = { id: message, deadline: state.time + 10, outcome: "pending", attempt };
      g.requestUntil = null;
      g.flow = `Broker → ${id}1: ${messageName(message)} returned by receive. Invisible within group ${id} until t=${state.time + 10}s.`;
      return true;
    }

    function render() {
      put("#trace-clock", `t = ${state.time} s`);
      put("#trace-event", state.event);
      put("#producer-receipt", state.receipt);
      find<HTMLButtonElement>('[data-action="publish"]').disabled = state.messages.length >= 6;
      find<HTMLButtonElement>('[data-action="undo"]').disabled = history.length === 0;
      find<HTMLElement>("#trace-queue").innerHTML = state.messages.length ? state.messages.map(id => `<li class="rounded-lg border border-stone-300 p-2 text-sm dark:border-slate-600"><strong>${messageName(id)}</strong><span class="ml-2 font-mono text-xs">Q1:${id}</span><p class="mt-1 text-xs">A: ${state.groups.A.acked.includes(id) ? "acknowledged" : "not acknowledged"} · B: ${state.groups.B.acked.includes(id) ? "acknowledged" : "not acknowledged"}</p></li>`).join("") : '<li class="text-sm">Queue empty.</li>';
      for (const id of ids) {
        const g = state.groups[id];
        const d = g.delivery;
        const disabled: Record<string, boolean> = { receive: g.requestUntil !== null || d !== null, process: !d || d.outcome !== "pending", fail: !d || d.outcome !== "pending", ack: !d || d.outcome !== "processed" };
        for (const [action, value] of Object.entries(disabled)) find<HTMLButtonElement>(`[data-action="${action}"][data-group="${id}"]`).disabled = value;
        put(`#trace-flow-${id}`, g.flow);
        put(`#trace-delivery-${id}`, d ? `${messageName(d.id)} · delivery attempt ${d.attempt}\n${d.outcome === "processed" ? "Business processing succeeded. Broker still awaits ACK." : d.outcome === "failed" ? "Processing failed. No ACK sent; wait for visibility timeout." : "Received; business processing has not run."}\nInvisible for ${d.deadline - state.time}s more.` : g.requestUntil !== null ? `Receive is waiting. Request times out in ${g.requestUntil - state.time}s.` : "No message in flight.");
        find<HTMLElement>(`#trace-delivery-${id}`).classList.add("whitespace-pre-line");
        put(`#trace-progress-${id}`, `Acknowledged: ${g.acked.map(messageName).join(", ") || "none"}`);
        put(`#trace-ready-${id}`, `Ready for group ${id}: ${available(g).map(messageName).join(", ") || "none"}`);
      }
    }

    root.addEventListener("click", event => {
      const button = (event.target as Element).closest<HTMLButtonElement>("button[data-action]");
      if (!button || button.disabled) return;
      const action = button.dataset.action;
      if (action === "reset") { state = initial(); history.length = 0; render(); return; }
      if (action === "undo") { const previous = history.pop(); if (previous) state = previous; render(); return; }
      history.push(structuredClone(state));
      if (history.length > 80) history.shift();
      if (action === "publish") {
        const id = state.messages.length;
        state.messages.push(id);
        state.receipt = `Producer → broker: ${messageName(id)}. Broker → producer: send receipt, stored at Q1:${id}. This does not mean either group processed it.`;
        const waiting = ids.filter(groupId => state.groups[groupId].requestUntil !== null && deliver(groupId));
        state.event = `${messageName(id)} stored. ${waiting.length ? `Waiting receive fulfilled in group ${waiting.join(" and ")}.` : "Consumers must receive it; publishing does not invoke business processing."}`;
      } else if (action === "time") {
        state.time += 5;
        const changes: string[] = [];
        for (const id of ids) {
          const g = state.groups[id];
          if (g.delivery && state.time >= g.delivery.deadline) {
            const name = messageName(g.delivery.id);
            g.delivery = null;
            g.flow = `Broker: ${name} is visible to group ${id} again. A new receive is needed.`;
            changes.push(`${id}: ${name} visibility expired`);
          }
          if (g.requestUntil !== null && state.time >= g.requestUntil) {
            g.requestUntil = null;
            g.flow = `Broker → ${id}1: receive returned empty after its wait timeout. The application may receive again.`;
            changes.push(`${id}: empty receive response`);
          }
        }
        state.event = changes.join(". ") || "Clock advanced; no delivery or request deadline expired.";
      } else {
        const id = button.dataset.group as GroupId;
        if (!ids.includes(id)) { history.pop(); return; }
        const g = state.groups[id];
        if (action === "receive") {
          if (deliver(id)) state.event = `Group ${id} sent receive; broker returned ${messageName(g.delivery!.id)}. Processing has not happened yet.`;
          else {
            g.requestUntil = state.time + 20;
            g.flow = `${id}1 → broker: receive. No eligible message; the request waits for a message or its timeout.`;
            state.event = `Group ${id}'s receive is waiting. Publish a message or advance time.`;
          }
        } else if (g.delivery && action === "process") {
          g.delivery.outcome = "processed";
          g.flow = `${id}1: business handler completed locally. No acknowledgement has reached the broker yet.`;
          state.event = `Group ${id} processed ${messageName(g.delivery.id)}. ACK separately to confirm consumption.`;
        } else if (g.delivery && action === "fail") {
          g.delivery.outcome = "failed";
          g.flow = `${id}1: business handler failed. SimpleConsumer sends no ACK in this example.`;
          state.event = `Group ${id} failed. Advance the clock to its invisibility deadline, then receive again. The other group can continue.`;
        } else if (g.delivery && action === "ack") {
          const name = messageName(g.delivery.id);
          g.acked.push(g.delivery.id);
          g.delivery = null;
          g.flow = `${id}1 → broker: ACK ${name}. Broker records success for group ${id} only.`;
          state.event = `${name} acknowledged by group ${id}. Stored data and the other group's state are unchanged.`;
        }
      }
      render();
    });
    render();
  }
  setupMessageTrace();
  document.addEventListener("astro:page-load", setupMessageTrace);
</script>
