---
// Replace app/src/pages/rocketmq/consumer-rebalancing.astro. No additional dependencies.
import BaseLayout from "../../layouts/BaseLayout.astro";

const panel =
  "rounded-xl border border-stone-300 bg-white p-4 dark:border-slate-600 dark:bg-slate-800";
const button =
  "rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm font-semibold hover:bg-sky-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-600 dark:bg-slate-800 dark:hover:bg-slate-700";
---

<BaseLayout title="RocketMQ · Queue and message load balancing" activePage="">
  <main id="mq-rebalancing" class="mx-auto max-w-6xl py-5">
    <header class="mb-4">
      <a href="/rocketmq/" class="text-sm text-sky-700 underline dark:text-sky-300">All RocketMQ demos</a>
      <h1 class="mt-2 text-2xl font-bold sm:text-3xl">What gets assigned: queues or messages?</h1>
      <p class="mt-2 text-sm text-stone-600 dark:text-slate-300">Four queues, one consumer group. Compare queue ownership with message-based delivery, then change the number of workers.</p>
    </header>

    <section aria-label="Simulation controls" class="sticky top-0 z-10 mb-3 rounded-xl border border-sky-300 bg-sky-50 p-3 shadow-sm dark:border-sky-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-2">
        <label class="text-sm font-semibold" for="allocation-mode">Allocation</label>
        <select id="allocation-mode" class={button}>
          <option value="queue">Queue-based · Pull / legacy clients</option>
          <option value="message">Message-based · 5.x Push / Simple</option>
        </select>
        <button type="button" data-action="add" class={button}>Add consumer</button>
        <button type="button" data-action="remove" class={button}>Remove last consumer</button>
        <button type="button" data-action="tick" class={`${button} border-sky-600 text-sky-800 dark:text-sky-300`}>Run one work tick</button>
        <button type="button" data-action="refill" class={button}>Reset workload</button>
        <button type="button" data-action="undo" class={button} disabled>Previous step</button>
        <button type="button" data-action="reset" class={button}>Reset all</button>
      </div>
      <p id="rebalance-event" role="status" aria-live="polite" class="mt-2 text-sm font-medium">Two consumers share four queues. Run a tick, then add a consumer.</p>
    </section>

    <p id="allocation-rule" class="mb-3 rounded-xl border border-amber-300 bg-amber-50 p-3 text-sm dark:border-amber-800 dark:bg-amber-950/20">Queue-based model: each queue is assigned to one consumer in this group. This limits the number of consumers with an assignment, not the number of processing threads.</p>
    <div class="mb-3 grid grid-cols-2 gap-2 sm:grid-cols-4" aria-label="Work summary">
      {[ ["workers", "Consumers"], ["eligible", "With available work"], ["processed", "Processed this tick"], ["backlog", "Messages remaining"] ].map(([id, label]) => (
        <div class={panel}><p class="text-xs text-stone-600 dark:text-slate-300">{label}</p><p id={`balance-${id}`} class="mt-1 font-mono text-xl font-bold">—</p></div>
      ))}
    </div>

    <div class="grid items-start gap-3 lg:grid-cols-2">
      <section class={panel} aria-labelledby="balance-queues-heading">
        <h2 id="balance-queues-heading" class="font-bold">Topic orders · stored backlog</h2>
        <p id="position-explanation" class="mt-1 text-xs text-stone-600 dark:text-slate-300">Offsets identify positions within each queue.</p>
        <div class="mt-3 grid gap-2 sm:grid-cols-2">
          {[0, 1, 2, 3].map(q => (
            <article id={`balance-q${q}`} class="rounded-lg border border-stone-300 p-3 dark:border-slate-600">
              <h3 class="font-mono font-bold">Q{q}</h3>
              <p id={`balance-owner-${q}`} class="mt-1 text-sm"></p>
              <p id={`balance-position-${q}`} class="mt-2 font-mono text-xs"></p>
              <div id={`balance-backlog-${q}`} class="mt-2 flex flex-wrap gap-1" aria-label={`Remaining messages in Q${q}`}></div>
              <p id={`balance-moved-${q}`} class="mt-2 min-h-8 text-xs font-semibold text-amber-800 dark:text-amber-300"></p>
            </article>
          ))}
        </div>
      </section>
      <section class={panel} aria-labelledby="balance-consumers-heading">
        <h2 id="balance-consumers-heading" class="font-bold">ConsumerGroup fulfillment</h2>
        <p class="mt-1 text-xs text-stone-600 dark:text-slate-300">All consumers subscribe to orders with the same filter. Each worker has capacity for one message per simulated tick.</p>
        <div id="balance-consumers" class="mt-3 grid gap-2 sm:grid-cols-2"></div>
      </section>
    </div>

    <details open class="mt-3 rounded-xl border border-stone-300 p-4 text-sm dark:border-slate-600">
      <summary class="cursor-pointer font-semibold">Try the same workload in both models</summary>
      <ol class="mt-2 list-decimal space-y-1 pl-5">
        <li>Add consumers until there are six. Run one tick in queue-based mode: four workers can receive work.</li>
        <li>Switch to message-based mode and choose Reset workload. Run one tick: all six can receive different messages across the same four queues.</li>
        <li>In queue-based mode, process a tick and remove a consumer. The highlighted ownership changes keep the group's committed positions.</li>
      </ol>
      <p class="mt-2">Capacity numbers describe this toy workload, not a throughput benchmark. Empty queues and uneven backlog can leave an assigned consumer without work.</p>
    </details>
    <details class="mt-3 rounded-xl border border-stone-300 p-4 text-sm dark:border-slate-600">
      <summary class="cursor-pointer font-semibold">Scope, handoff, and sources</summary>
      <p class="mt-2">RocketMQ documents message-based load balancing for its 5.x PushConsumer and SimpleConsumer model; PullConsumer and legacy clients use queue-based allocation. Check the client API and version, not just the broker version.</p>
      <p class="mt-2">Queue assignment here is deterministic round-robin. Message allocation uses a deterministic fair traversal for comparison; real delivery is demand-driven. Normal messages are used, so no business FIFO guarantee is implied. One tick combines delivery, processing, and successful acknowledgement/commit.</p>
      <p class="mt-2">Membership changes occur between ticks, after all shown work is committed. This is a clean handoff: real failure detection and rebalancing take time, and uncommitted work can be redelivered. Message mode shows the next unprocessed storage position in this simplified successful trace, not a client-managed commit offset.</p>
      <p class="mt-2">See <a class="text-sky-700 underline dark:text-sky-300" href="/rocketmq/message-trace/">separate receive / process / ACK steps</a>. Sources: <a class="text-sky-700 underline dark:text-sky-300" href="https://rocketmq.apache.org/docs/featureBehavior/08consumerloadbalance/">load balancing</a> and <a class="text-sky-700 underline dark:text-sky-300" href="https://rocketmq.apache.org/docs/featureBehavior/06consumertype/">consumer types</a>.</p>
    </details>
    <noscript><p class="mt-4">Enable JavaScript to run the simulation.</p></noscript>
  </main>
</BaseLayout>

<script>
  function setupRebalancing() {
    const root = document.querySelector<HTMLElement>("#mq-rebalancing");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "true";
    type Mode = "queue" | "message";
    type State = { mode: Mode; count: number; done: number[]; tick: number; cursor: number; work: string[]; moved: string[]; event: string };
    const starts = [12, 8, 15, 5];
    const sizes = [8, 4, 6, 2];
    const initial = (): State => ({ mode: "queue", count: 2, done: [0, 0, 0, 0], tick: 0, cursor: 0, work: [], moved: ["", "", "", ""], event: "Two consumers share four queues. Run a tick, then add a consumer." });
    let state = initial();
    const history: State[] = [];
    const find = <T extends Element>(selector: string) => root.querySelector<T>(selector)!;
    const put = (selector: string, value: string | number) => { find<HTMLElement>(selector).textContent = String(value); };
    const remaining = (q: number) => sizes[q] - state.done[q];
    const assigned = (consumer: number) => [0, 1, 2, 3].filter(q => q % state.count === consumer);
    function save() { history.push(structuredClone(state)); if (history.length > 80) history.shift(); }

    function render() {
      find<HTMLSelectElement>("#allocation-mode").value = state.mode;
      put("#rebalance-event", state.event);
      put("#allocation-rule", state.mode === "queue" ? "Queue-based model: each queue is assigned to one consumer in this group. This limits the number of consumers with an assignment, not the number of processing threads." : "Message-based model: consumers may receive different messages from the same queue. Queue count is not a hard ceiling on the number of participating consumers; each delivery has its own acknowledgement state.");
      const backlog = sizes.reduce((sum, _, q) => sum + remaining(q), 0);
      const eligible = state.mode === "message" ? Math.min(state.count, backlog) : Array.from({ length: state.count }, (_, c) => assigned(c).some(q => remaining(q) > 0)).filter(Boolean).length;
      put("#balance-workers", state.count);
      put("#balance-eligible", eligible);
      put("#balance-processed", state.work.filter(Boolean).length);
      put("#balance-backlog", backlog);
      put("#position-explanation", state.mode === "queue" ? "Next committed offset belongs to the group's progress in each queue." : "Next pending storage position is shown for this successful trace; acknowledgements are per message.");
      for (let q = 0; q < 4; q++) {
        put(`#balance-owner-${q}`, state.mode === "queue" ? `Assigned to C${q % state.count + 1}` : "No exclusive consumer assignment");
        put(`#balance-position-${q}`, `${state.mode === "queue" ? "Group next offset" : "Next pending position"}: ${starts[q] + state.done[q]} · end: ${starts[q] + sizes[q]}`);
        find<HTMLElement>(`#balance-backlog-${q}`).innerHTML = Array.from({ length: remaining(q) }, (_, i) => `<span class="rounded border border-sky-300 bg-sky-50 px-2 py-1 font-mono text-xs dark:border-sky-700 dark:bg-sky-950/30">${starts[q] + state.done[q] + i}</span>`).join("") || '<span class="text-xs">No pending messages</span>';
        put(`#balance-moved-${q}`, state.moved[q]);
        find<HTMLElement>(`#balance-q${q}`).classList.toggle("ring-2", !!state.moved[q]);
        find<HTMLElement>(`#balance-q${q}`).classList.toggle("ring-amber-400", !!state.moved[q]);
      }
      find<HTMLElement>("#balance-consumers").innerHTML = Array.from({ length: state.count }, (_, c) => {
        const queues = assigned(c);
        const capacity = state.mode === "queue" ? queues.length ? `Assigned ${queues.map(q => `Q${q}`).join(", ")}` : "Idle: no queue assignment" : "May receive from any queue";
        return `<article class="rounded-lg border border-stone-300 p-3 dark:border-slate-600"><h3 class="font-bold">Consumer C${c + 1}</h3><p class="mt-1 text-xs">${capacity}</p><p class="mt-2 text-sm font-semibold text-sky-800 dark:text-sky-300">${state.work[c] || (state.tick ? "No message processed in the last tick" : "No tick run yet")}</p></article>`;
      }).join("");
      find<HTMLButtonElement>('[data-action="add"]').disabled = state.count >= 6;
      find<HTMLButtonElement>('[data-action="remove"]').disabled = state.count <= 1;
      find<HTMLButtonElement>('[data-action="tick"]').disabled = backlog === 0;
      find<HTMLButtonElement>('[data-action="undo"]').disabled = !history.length;
    }

    find<HTMLSelectElement>("#allocation-mode").addEventListener("change", event => {
      save();
      state.mode = (event.target as HTMLSelectElement).value as Mode;
      state.work = [];
      state.moved = ["", "", "", ""];
      state.event = "Comparison mode changed; membership and remaining work are preserved. Reset workload for an equal starting backlog. This is not a live consumer-group API switch.";
      render();
    });
    root.addEventListener("click", event => {
      const button = (event.target as Element).closest<HTMLButtonElement>("button[data-action]");
      if (!button || button.disabled) return;
      const action = button.dataset.action;
      if (action === "reset") { state = initial(); history.length = 0; render(); return; }
      if (action === "undo") { const previous = history.pop(); if (previous) state = previous; render(); return; }
      save();
      state.moved = ["", "", "", ""];
      state.work = [];
      if (action === "add" || action === "remove") {
        const before = state.count;
        state.count += action === "add" ? 1 : -1;
        if (state.mode === "queue") {
          for (let q = 0; q < 4; q++) if (q % before !== q % state.count) state.moved[q] = `C${q % before + 1} → C${q % state.count + 1}; committed offset retained`;
        }
        state.event = state.mode === "queue" ? `${before} → ${state.count} consumers. ${state.moved.filter(Boolean).length} queue assignments changed. Previously committed work stays committed.` : `${before} → ${state.count} consumers. No exclusive queue ownership to transfer; the next tick distributes messages among available workers.`;
      } else if (action === "refill") {
        state.done = [0, 0, 0, 0]; state.tick = 0; state.cursor = 0;
        state.event = "Demo workload reset to 20 messages. Allocation mode and consumer count retained. This reset is not a broker operation.";
      } else if (action === "tick") {
        state.tick++;
        for (let c = 0; c < state.count; c++) {
          // ponytail: deterministic sequential scheduler for a visual comparison, not a throughput model.
          const candidates = state.mode === "queue" ? assigned(c) : [0, 1, 2, 3].map(n => (state.cursor + n) % 4);
          const q = candidates.find(q => remaining(q) > 0);
          if (q === undefined) { state.work[c] = ""; continue; }
          state.work[c] = `Q${q}:${starts[q] + state.done[q]} → C${c + 1} → ${state.mode === "queue" ? "commit" : "ACK"}`;
          state.done[q]++;
          if (state.mode === "message") state.cursor = (q + 1) % 4;
        }
        const processed = state.work.filter(Boolean).length;
        state.event = `Tick ${state.tick}: ${processed} message${processed === 1 ? "" : "s"} processed by ${processed} worker${processed === 1 ? "" : "s"}; at most one per worker. ${state.count - processed} worker(s) had no available work.`;
      }
      render();
    });
    render();
  }
  setupRebalancing();
  document.addEventListener("astro:page-load", setupRebalancing);
</script>
