---
import BaseLayout from "../../layouts/BaseLayout.astro";

const queues = [
  { id: "Q0", offset: 12 },
  { id: "Q1", offset: 8 },
  { id: "Q2", offset: 15 },
  { id: "Q3", offset: 5 },
] as const;

const inheritedSettings = [
  ["Subscription", "Topic orders · tag = order.created"],
  ["Delivery order", "Concurrent"],
  ["Retry policy", "Maximum 16 attempts"],
] as const;
---

<BaseLayout title="RocketMQ Consumer Rebalancing" activePage="">
  <main id="rebalance-demo" class="mx-auto max-w-6xl py-8">
    <header class="mb-8 max-w-3xl">
      <p class="mb-2 font-mono text-sm font-semibold text-green-700 dark:text-green-400">
        Apache RocketMQ · ConsumerGroup · Consumer
      </p>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Queue allocation and consumer rebalancing
      </h1>
      <p class="mt-3 text-stone-600 dark:text-slate-300">
        Add and remove consumers to see how one consumer group redistributes four MessageQueues
        while retaining the group’s consumption progress.
      </p>
    </header>

    <section
      class="rounded-2xl border border-green-200 bg-green-50 p-4 dark:border-green-900 dark:bg-green-950/30 sm:p-5"
      aria-labelledby="rule-heading"
    >
      <p class="font-mono text-xs font-bold uppercase tracking-wide text-green-700 dark:text-green-400">
        Scaling rule
      </p>
      <h2 id="rule-heading" class="mt-1 text-lg font-semibold text-green-950 dark:text-green-100">
        Queues are the parallelism ceiling inside one consumer group
      </h2>
      <p class="mt-2 text-sm text-green-900 dark:text-green-200">
        Consumers in the same group share queue work. With four queues, at most four consumers can
        hold an assignment at once; additional consumers remain available but idle.
      </p>
    </section>

    <section
      class="mt-6 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-6"
      aria-labelledby="controls-heading"
    >
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="font-mono text-sm font-semibold text-green-700 dark:text-green-400">Simulation</p>
          <h2 id="controls-heading" class="text-xl font-semibold">Change group membership</h2>
        </div>
        <span
          id="rebalance-status"
          class="rounded-full bg-green-100 px-3 py-1 font-mono text-xs font-bold text-green-700 dark:bg-green-950 dark:text-green-300"
          aria-live="polite"
        >
          BALANCED
        </span>
      </div>

      <div class="mt-5 flex flex-wrap gap-3">
        <button
          id="add-consumer"
          type="button"
          class="rounded-lg bg-green-700 px-4 py-2.5 font-semibold text-white transition hover:bg-green-800 focus:outline-none focus:ring-2 focus:ring-green-600 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40 dark:bg-green-600 dark:hover:bg-green-500 dark:focus:ring-offset-slate-800"
        >
          Add consumer
        </button>
        <button
          id="remove-consumer"
          type="button"
          class="rounded-lg border border-green-300 bg-white px-4 py-2.5 font-semibold text-green-800 transition hover:bg-green-50 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40 dark:border-green-800 dark:bg-slate-900 dark:text-green-300 dark:hover:bg-green-950 dark:focus:ring-offset-slate-800"
        >
          Remove consumer
        </button>
        <button
          id="consume-batch"
          type="button"
          class="rounded-lg bg-violet-700 px-4 py-2.5 font-semibold text-white transition hover:bg-violet-800 focus:outline-none focus:ring-2 focus:ring-violet-600 focus:ring-offset-2 dark:bg-violet-600 dark:hover:bg-violet-500 dark:focus:ring-offset-slate-800"
        >
          Consume one from each queue
        </button>
        <button
          id="reset-rebalance"
          type="button"
          class="rounded-lg border border-stone-300 bg-white px-4 py-2.5 font-semibold text-stone-700 transition hover:bg-stone-100 focus:outline-none focus:ring-2 focus:ring-stone-400 focus:ring-offset-2 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-700 dark:focus:ring-offset-slate-800"
        >
          Reset
        </button>
      </div>

      <p id="rebalance-explanation" class="mt-4 rounded-xl bg-stone-100 p-3 text-sm text-stone-600 dark:bg-slate-900 dark:text-slate-300" aria-live="polite">
        Two consumers divide four queues. Consumption offsets belong to the group’s queue progress,
        not to either consumer process.
      </p>
    </section>

    <section
      class="mt-6 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-6"
      aria-labelledby="group-heading"
    >
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="font-mono text-[10px] font-bold uppercase tracking-wide text-green-700 dark:text-green-400">
            Logical resource
          </p>
          <h2 id="group-heading" class="mt-1 text-xl font-semibold">
            ConsumerGroup <code>fulfillment</code>
          </h2>
          <p class="mt-2 max-w-2xl text-sm text-stone-600 dark:text-slate-300">
            Membership can change, but the group identity, subscription, retry behavior, and queue
            offsets survive those process changes.
          </p>
        </div>
        <span class="rounded-full bg-stone-100 px-3 py-1 font-mono text-xs text-stone-600 dark:bg-slate-900 dark:text-slate-300">
          clustering consumption
        </span>
      </div>

      <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" aria-label="Group capacity summary">
        <div class="rounded-xl bg-stone-100 p-3 dark:bg-slate-900">
          <p class="text-xs font-bold uppercase tracking-wide text-stone-500 dark:text-slate-400">Queues</p>
          <p class="mt-1 font-mono text-2xl font-bold">4</p>
        </div>
        <div class="rounded-xl bg-stone-100 p-3 dark:bg-slate-900">
          <p class="text-xs font-bold uppercase tracking-wide text-stone-500 dark:text-slate-400">Members</p>
          <p id="member-count" class="mt-1 font-mono text-2xl font-bold">2</p>
        </div>
        <div class="rounded-xl bg-stone-100 p-3 dark:bg-slate-900">
          <p class="text-xs font-bold uppercase tracking-wide text-stone-500 dark:text-slate-400">Assigned members</p>
          <p id="active-count" class="mt-1 font-mono text-2xl font-bold">2</p>
        </div>
        <div class="rounded-xl bg-stone-100 p-3 dark:bg-slate-900">
          <p class="text-xs font-bold uppercase tracking-wide text-stone-500 dark:text-slate-400">Idle members</p>
          <p id="idle-count" class="mt-1 font-mono text-2xl font-bold">0</p>
        </div>
      </div>

      <div class="mt-5 grid gap-5 lg:grid-cols-[1fr_1.25fr]">
        <section aria-labelledby="settings-heading">
          <h3 id="settings-heading" class="font-semibold">Group-owned behavior</h3>
          <dl class="mt-3 space-y-2">
            {inheritedSettings.map(([label, value]) => (
              <div class="rounded-lg border border-stone-200 bg-stone-50 p-3 dark:border-slate-700 dark:bg-slate-900">
                <dt class="text-xs font-bold uppercase tracking-wide text-stone-500 dark:text-slate-400">{label}</dt>
                <dd class="mt-1 font-mono text-sm">{value}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-3 text-sm text-stone-500 dark:text-slate-400">
            Every member must use consistent consumption behavior. The consumers are runtime workers,
            not separate subscriptions.
          </p>
        </section>

        <section aria-labelledby="members-heading">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 id="members-heading" class="font-semibold">Current consumer processes</h3>
            <span class="font-mono text-xs text-stone-500 dark:text-slate-400">client IDs generated by SDK</span>
          </div>
          <div id="consumer-grid" class="mt-3 grid gap-3 sm:grid-cols-2"></div>
        </section>
      </div>

      <div class="my-6 flex items-center gap-3 text-stone-400 dark:text-slate-500" aria-hidden="true">
        <div class="h-px flex-1 bg-stone-200 dark:bg-slate-700"></div>
        <span class="font-mono text-xs font-bold uppercase tracking-wide">queue assignment</span>
        <div class="h-px flex-1 bg-stone-200 dark:bg-slate-700"></div>
      </div>

      <section aria-labelledby="queues-heading">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h3 id="queues-heading" class="font-semibold">Topic <code>orders</code> · MessageQueues</h3>
            <p class="mt-1 text-sm text-stone-500 dark:text-slate-400">
              Each card shows the group’s next offset and the consumer currently responsible for that queue.
            </p>
          </div>
          <span class="rounded-full bg-amber-100 px-2 py-1 text-[10px] font-bold uppercase tracking-wide text-amber-700 dark:bg-amber-950 dark:text-amber-300">
            changed assignments flash amber
          </span>
        </div>

        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {queues.map((queue) => (
            <article
              id={`queue-${queue.id.toLowerCase()}`}
              data-queue-index={queue.id.slice(1)}
              class="rounded-xl border-2 border-sky-300 bg-sky-50 p-3 transition dark:border-sky-800 dark:bg-sky-950/20"
            >
              <div class="flex items-center justify-between gap-2">
                <h4 class="font-mono font-bold">{queue.id}</h4>
                <span class="rounded bg-sky-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-sky-700 dark:bg-sky-950 dark:text-sky-300">
                  ordered
                </span>
              </div>
              <dl class="mt-3 space-y-2 text-sm">
                <div>
                  <dt class="text-xs text-stone-500 dark:text-slate-400">Assigned consumer</dt>
                  <dd id={`queue-${queue.id.toLowerCase()}-owner`} class="mt-0.5 font-mono font-bold"></dd>
                </div>
                <div>
                  <dt class="text-xs text-stone-500 dark:text-slate-400">Group next offset</dt>
                  <dd id={`queue-${queue.id.toLowerCase()}-offset`} class="mt-0.5 font-mono text-xl font-bold">{queue.offset}</dd>
                </div>
              </dl>
              <p id={`queue-${queue.id.toLowerCase()}-movement`} class="mt-3 hidden text-xs font-semibold text-amber-700 dark:text-amber-300"></p>
            </article>
          ))}
        </div>
      </section>

      <div class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-900 dark:bg-amber-950/30 dark:text-amber-200">
        <strong>Model boundary:</strong> this page uses a deterministic round-robin assignment to make
        rebalancing visible. A real client’s allocation depends on its configured allocation strategy
        and current membership, but queue progress remains associated with the consumer group.
      </div>
    </section>

    <section
      class="mt-6 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-6"
      aria-labelledby="log-heading"
    >
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="font-mono text-sm font-semibold text-green-700 dark:text-green-400">Event log</p>
          <h2 id="log-heading" class="text-xl font-semibold">Membership and progress</h2>
        </div>
        <span class="font-mono text-xs text-stone-500 dark:text-slate-400">newest event last</span>
      </div>
      <ol id="rebalance-log" class="mt-4 space-y-2" aria-live="polite"></ol>
    </section>
  </main>
</BaseLayout>

<script>
  type LogTone = "normal" | "success" | "warning";

  function setupRebalanceDemo() {
    const root = document.querySelector<HTMLElement>("#rebalance-demo");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "true";

    const find = <T extends Element>(selector: string) => root.querySelector<T>(selector)!;
    const addButton = find<HTMLButtonElement>("#add-consumer");
    const removeButton = find<HTMLButtonElement>("#remove-consumer");
    const consumerGrid = find<HTMLElement>("#consumer-grid");
    const eventLog = find<HTMLOListElement>("#rebalance-log");
    const initialOffsets = [12, 8, 15, 5];

    let consumerCount = 2;
    let offsets = [...initialOffsets];
    let assignments = allocate(consumerCount);

    function allocate(memberCount: number) {
      return [0, 1, 2, 3].map((queueIndex) => (queueIndex % memberCount) + 1);
    }

    function animate(element: HTMLElement) {
      element.animate(
        [
          { transform: "scale(0.98)", opacity: "0.65" },
          { transform: "scale(1)", opacity: "1" },
        ],
        {
          duration: matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 350,
          easing: "ease-out",
        },
      );
    }

    function setStatus(text: string, warning = false) {
      const status = find<HTMLElement>("#rebalance-status");
      status.textContent = text;
      status.className = warning
        ? "rounded-full bg-amber-100 px-3 py-1 font-mono text-xs font-bold text-amber-700 dark:bg-amber-950 dark:text-amber-300"
        : "rounded-full bg-green-100 px-3 py-1 font-mono text-xs font-bold text-green-700 dark:bg-green-950 dark:text-green-300";
    }

    function appendLog(title: string, detail: string, tone: LogTone = "normal") {
      const item = document.createElement("li");
      item.className =
        tone === "warning"
          ? "rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-200"
          : tone === "success"
            ? "rounded-lg border border-green-300 bg-green-50 p-3 text-sm text-green-900 dark:border-green-800 dark:bg-green-950/30 dark:text-green-200"
            : "rounded-lg border border-stone-200 bg-stone-50 p-3 text-sm dark:border-slate-700 dark:bg-slate-900";
      const strong = document.createElement("strong");
      strong.textContent = `${title} `;
      const text = document.createElement("span");
      text.textContent = detail;
      item.append(strong, text);
      eventLog.append(item);
      animate(item);
    }

    function renderConsumers() {
      consumerGrid.replaceChildren();
      for (let consumer = 1; consumer <= consumerCount; consumer += 1) {
        const assignedQueues = assignments
          .map((owner, queueIndex) => (owner === consumer ? `Q${queueIndex}` : undefined))
          .filter((queue): queue is string => Boolean(queue));
        const card = document.createElement("article");
        card.className = assignedQueues.length
          ? "rounded-xl border-2 border-green-300 bg-green-50 p-3 dark:border-green-800 dark:bg-green-950/20"
          : "rounded-xl border-2 border-dashed border-stone-300 bg-stone-50 p-3 text-stone-500 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-400";

        const headingRow = document.createElement("div");
        headingRow.className = "flex items-center justify-between gap-2";
        const heading = document.createElement("h4");
        heading.className = "font-bold";
        heading.textContent = `Consumer C${consumer}`;
        const badge = document.createElement("span");
        badge.className = assignedQueues.length
          ? "rounded-full bg-green-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-green-700 dark:bg-green-950 dark:text-green-300"
          : "rounded-full bg-stone-200 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-stone-600 dark:bg-slate-700 dark:text-slate-300";
        badge.textContent = assignedQueues.length ? "active" : "idle";
        headingRow.append(heading, badge);

        const clientId = document.createElement("p");
        clientId.className = "mt-2 font-mono text-xs text-stone-500 dark:text-slate-400";
        clientId.textContent = `clientId consumer-${consumer}`;
        const assignment = document.createElement("p");
        assignment.className = "mt-2 text-sm";
        assignment.textContent = assignedQueues.length
          ? `Assigned ${assignedQueues.join(", ")}`
          : "No queue available";

        card.append(headingRow, clientId, assignment);
        consumerGrid.append(card);
      }
    }

    function render(previousAssignments?: number[]) {
      find<HTMLElement>("#member-count").textContent = String(consumerCount);
      find<HTMLElement>("#active-count").textContent = String(Math.min(consumerCount, 4));
      find<HTMLElement>("#idle-count").textContent = String(Math.max(consumerCount - 4, 0));

      for (let queueIndex = 0; queueIndex < 4; queueIndex += 1) {
        const queueCard = find<HTMLElement>(`#queue-q${queueIndex}`);
        const owner = assignments[queueIndex];
        find<HTMLElement>(`#queue-q${queueIndex}-owner`).textContent = `Consumer C${owner}`;
        find<HTMLElement>(`#queue-q${queueIndex}-offset`).textContent = String(offsets[queueIndex]);
        const movement = find<HTMLElement>(`#queue-q${queueIndex}-movement`);
        const changed = Boolean(previousAssignments && previousAssignments[queueIndex] !== owner);
        movement.classList.toggle("hidden", !changed);
        if (changed && previousAssignments) {
          movement.textContent = `Moved from C${previousAssignments[queueIndex]} to C${owner}`;
          queueCard.classList.add(
            "ring-4",
            "ring-amber-300",
            "ring-offset-2",
            "dark:ring-amber-800",
            "dark:ring-offset-slate-900",
          );
          animate(queueCard);
        } else {
          queueCard.classList.remove(
            "ring-4",
            "ring-amber-300",
            "ring-offset-2",
            "dark:ring-amber-800",
            "dark:ring-offset-slate-900",
          );
        }
      }

      renderConsumers();
      addButton.disabled = consumerCount >= 6;
      removeButton.disabled = consumerCount <= 1;
    }

    function rebalance(nextCount: number) {
      const previousCount = consumerCount;
      const previousAssignments = [...assignments];
      consumerCount = nextCount;
      assignments = allocate(consumerCount);
      render(previousAssignments);

      const movedQueues = assignments.filter(
        (owner, queueIndex) => owner !== previousAssignments[queueIndex],
      ).length;
      setStatus("REBALANCED", true);
      find<HTMLElement>("#rebalance-explanation").textContent =
        `${previousCount} → ${consumerCount} members caused ${movedQueues} queue assignment${movedQueues === 1 ? "" : "s"} to change. Every group offset was retained.`;
      appendLog(
        "Membership changed.",
        `${previousCount} → ${consumerCount} consumers; ${movedQueues} queues moved and no consumption progress was reset.`,
        "warning",
      );
    }

    addButton.addEventListener("click", () => {
      if (consumerCount >= 6) return;
      rebalance(consumerCount + 1);
    });

    removeButton.addEventListener("click", () => {
      if (consumerCount <= 1) return;
      rebalance(consumerCount - 1);
    });

    find<HTMLButtonElement>("#consume-batch").addEventListener("click", () => {
      offsets = offsets.map((offset) => offset + 1);
      render();
      setStatus("PROGRESS SAVED");
      find<HTMLElement>("#rebalance-explanation").textContent =
        "Each assigned consumer processed one message. The four next offsets advanced on the consumer group and will survive the next rebalance.";
      appendLog(
        "Batch acknowledged.",
        `Group offsets are now Q0:${offsets[0]}, Q1:${offsets[1]}, Q2:${offsets[2]}, Q3:${offsets[3]}.`,
        "success",
      );
      for (let queueIndex = 0; queueIndex < 4; queueIndex += 1) {
        animate(find<HTMLElement>(`#queue-q${queueIndex}`));
      }
    });

    find<HTMLButtonElement>("#reset-rebalance").addEventListener("click", () => {
      consumerCount = 2;
      offsets = [...initialOffsets];
      assignments = allocate(consumerCount);
      render();
      setStatus("BALANCED");
      find<HTMLElement>("#rebalance-explanation").textContent =
        "Two consumers divide four queues. Consumption offsets belong to the group’s queue progress, not to either consumer process.";
      eventLog.replaceChildren();
      appendLog("Initial allocation.", "C1 owns Q0 and Q2; C2 owns Q1 and Q3.");
    });

    render();
    appendLog("Initial allocation.", "C1 owns Q0 and Q2; C2 owns Q1 and Q3.");
  }

  document.addEventListener("astro:page-load", setupRebalanceDemo);
</script>
