---
// Replace app/src/pages/rocketmq/litetopic-comparison.astro. No additional dependencies.
import BaseLayout from "../../layouts/BaseLayout.astro";

const panel =
  "rounded-xl border border-stone-300 bg-white p-4 dark:border-slate-600 dark:bg-slate-800";
const button =
  "rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm font-semibold hover:bg-sky-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-600 dark:bg-slate-800 dark:hover:bg-slate-700";
const sessions = ["481", "925"];
---

<BaseLayout title="RocketMQ · Shared topics and LiteTopic channels" activePage="">
  <main id="mq-litetopic" class="mx-auto max-w-6xl py-5">
    <header class="mb-4">
      <a href="/rocketmq/" class="text-sm text-sky-700 underline dark:text-sky-300">All RocketMQ demos</a>
      <h1 class="mt-2 text-2xl font-bold sm:text-3xl">Shared queues or a channel per session?</h1>
      <p class="mt-2 text-sm text-stone-600 dark:text-slate-300">Send the same events to two separate example topics. Compare subscription scope, ordering, and child-channel expiry.</p>
    </header>

    <section aria-label="Simulation controls" class="sticky top-0 z-10 mb-3 rounded-xl border border-sky-300 bg-sky-50 p-3 shadow-sm dark:border-sky-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-2">
        {sessions.map(id => <button type="button" data-action="send" data-session={id} class={`${button} border-sky-600 text-sky-800 dark:text-sky-300`}>Send session {id}</button>)}
        <button type="button" data-action="time" class={button}>Advance 15 minutes</button>
        <button type="button" data-action="undo" class={button} disabled>Previous step</button>
        <button type="button" data-action="reset" class={button}>Reset</button>
        <output id="lite-clock" aria-label="Simulated time" class="ml-auto font-mono text-sm">t = 0 min</output>
      </div>
      <p id="lite-event" role="status" aria-live="polite" class="mt-2 text-sm font-medium">Both parent topics exist. Send creates a LiteTopic child, but does not subscribe a consumer.</p>
    </section>

    <div class="grid items-start gap-3 lg:grid-cols-2">
      <section class={panel} aria-labelledby="shared-heading">
        <h2 id="shared-heading" class="font-bold">Non-Lite topic · session-events</h2>
        <label for="shared-mode" class="mt-3 block text-sm font-semibold">Message configuration</label>
        <select id="shared-mode" class={`${button} mt-1 w-full`}>
          <option value="normal">Normal messages · no ordering guarantee</option>
          <option value="fifo">FIFO topic · messageGroup = sessionId</option>
        </select>
        <p class="mt-1 text-xs text-stone-600 dark:text-slate-300">Choose before sending; Reset unlocks this setting. A FIFO topic is a different configuration, not a key added to normal messages.</p>
        <p id="shared-rule" class="mt-3 min-h-12 text-sm">Session identity is message data. Events can go to different shared queues.</p>
        <div class="mt-3 grid grid-cols-2 gap-2">
          {[0, 1, 2, 3].map(q => <article class="rounded-lg border border-stone-300 p-2 dark:border-slate-600"><h3 class="font-mono text-sm font-bold">Q{q}</h3><ol id={`shared-q${q}`} class="mt-1 space-y-1 text-xs"><li>Empty</li></ol></article>)}
        </div>
        <div class="mt-3 rounded-lg bg-stone-100 p-3 text-sm dark:bg-slate-900">
          <h3 class="font-semibold">Group shared-workers</h3>
          <p class="mt-1 text-xs">N1 and N2 both subscribe to session-events / all tags.</p>
          <button type="button" data-action="consume-shared" class={`${button} mt-2`} disabled>Consume one shared message</button>
          <p id="shared-delivery" class="mt-2 text-xs">No delivery yet.</p>
        </div>
        <p class="mt-3 text-xs text-stone-600 dark:text-slate-300">The parent remains until explicitly deleted. Message retention is separate and is not simulated here.</p>
      </section>

      <section class={panel} aria-labelledby="lite-heading">
        <h2 id="lite-heading" class="font-bold">Lite-type topic · agent-sessions</h2>
        <p class="mt-2 text-sm">Each child has its own ordered queue and subscription scope. Demo idle TTL: 60 simulated minutes.</p>
        <p id="lite-count" class="mt-2 text-sm font-semibold">Active child channels: 0</p>
        <div class="mt-3 grid gap-2 sm:grid-cols-2">
          {sessions.map(id => <article class="rounded-lg border border-violet-300 p-3 dark:border-violet-800"><h3 class="font-mono text-sm font-bold">session-{id}</h3><p id={`child-status-${id}`} class="mt-2 text-xs">Absent</p><ol id={`child-messages-${id}`} class="mt-2 space-y-1 text-xs"></ol></article>)}
        </div>
        <div class="mt-3 rounded-lg bg-stone-100 p-3 dark:bg-slate-900">
          <h3 class="text-sm font-semibold">Group lite-workers · independent child sets</h3>
          {sessions.map((id, i) => <div class="mt-3 border-t border-stone-300 pt-2 dark:border-slate-600"><p class="text-sm font-semibold">Consumer L{i + 1}</p><div class="mt-1 flex flex-wrap gap-2"><button type="button" data-action="subscribe" data-session={id} class={button}>Subscribe L{i + 1} to {id}</button><button type="button" data-action="consume-lite" data-session={id} class={button} disabled>Consume with L{i + 1}</button></div><p id={`subscription-${id}`} class="mt-1 text-xs">No subscription selected.</p></div>)}
          <p id="lite-delivery" class="mt-3 text-xs">No delivery yet.</p>
        </div>
      </section>
    </div>

    <details open class="mt-3 rounded-xl border border-stone-300 p-4 text-sm dark:border-slate-600">
      <summary class="cursor-pointer font-semibold">Experiments that reveal the difference</summary>
      <ol class="mt-2 list-decimal space-y-1 pl-5">
        <li>Send two events for session 481. The LiteTopic appears, but L1 still cannot consume until you subscribe it.</li>
        <li>Consume shared messages: the normal-message example can deliver the second event first. Reset, select FIFO, and repeat to preserve the session's order without LiteTopics.</li>
        <li>Unsubscribe L1. The child stays. Advance the clock: expiry follows the last send (or creation), not the unsubscribe button.</li>
        <li>Create both children. Keep sending to 925 while advancing time. Only the idle child expires. Send to the expired child to create it again.</li>
      </ol>
    </details>
    <details class="mt-3 rounded-xl border border-stone-300 p-4 text-sm dark:border-slate-600">
      <summary class="cursor-pointer font-semibold">Scope and sources</summary>
      <p class="mt-2">LiteTopics require RocketMQ Server 5.5.0+ and the gRPC client 5.1.0+ per the linked documentation. Parents are created in advance; a LiteTopic is created on first send or subscription. Each contains one queue by default. Sending restarts its idle clock. Consumption and unsubscribing do not send new messages.</p>
      <p class="mt-2">The clock is manual. Expiry is shown at the first time step past TTL; real cleanup is asynchronous. Subscription selections represent client intent; reconnect and subscription recovery are outside this demo. On re-creation, offset 0 belongs to a new child generation, not the deleted queue.</p>
      <p class="mt-2">The non-Lite FIFO example uses serial sends by one producer and ordered processing for each message group. Normal-mode queue routing and delivery order are illustrative choices. Each Consume click combines receive, processing, and successful acknowledgement. Delivery retries and storage retention are omitted; consumed records remain visible until the child expires. Up to 12 sends can be explored before reset.</p>
      <p class="mt-2">Sources: <a class="text-sky-700 underline dark:text-sky-300" href="https://rocketmq.apache.org/docs/domainModel/03litetopic/">LiteTopic domain model</a>, <a class="text-sky-700 underline dark:text-sky-300" href="https://rocketmq.apache.org/docs/featureBehavior/03fifomessage/">FIFO and message groups</a>. Explore <a class="text-sky-700 underline dark:text-sky-300" href="/rocketmq/message-trace/">receive / process / ACK</a> separately.</p>
    </details>
    <noscript><p class="mt-4">Enable JavaScript to run the simulation.</p></noscript>
  </main>
</BaseLayout>

<script>
  function setupLiteTopics() {
    const root = document.querySelector<HTMLElement>("#mq-litetopic");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "true";
    type Session = "481" | "925";
    type Message = { session: Session; sequence: number; offset: number; queue: number; consumed: boolean };
    type Child = { lastSend: number; generation: number; messages: Message[] };
    type State = { time: number; mode: "normal" | "fifo"; shared: Message[]; children: Record<Session, Child | null>; subscribed: Record<Session, boolean>; generations: Record<Session, number>; sent: Record<Session, number>; event: string; sharedDelivery: string; liteDelivery: string; deliveries: number };
    const sessions: Session[] = ["481", "925"];
    const initial = (): State => ({ time: 0, mode: "normal", shared: [], children: { "481": null, "925": null }, subscribed: { "481": false, "925": false }, generations: { "481": 0, "925": 0 }, sent: { "481": 0, "925": 0 }, event: "Both parent topics exist. Send creates a LiteTopic child, but does not subscribe a consumer.", sharedDelivery: "No delivery yet.", liteDelivery: "No delivery yet.", deliveries: 0 });
    let state = initial();
    const history: State[] = [];
    const find = <T extends Element>(selector: string) => root.querySelector<T>(selector)!;
    const put = (selector: string, value: string) => { find<HTMLElement>(selector).textContent = value; };
    const name = (m: Message) => `S${m.session}-M${m.sequence}`;
    const messageRow = (m: Message) => `<li class="rounded border border-stone-300 px-2 py-1 dark:border-slate-600"><span class="font-mono">${m.offset} · ${name(m)}</span><span class="block ${m.consumed ? "text-green-800 dark:text-green-300" : "text-stone-600 dark:text-slate-300"}">${m.consumed ? "Acknowledged · stored" : "Pending"}</span></li>`;
    function save() { history.push(structuredClone(state)); if (history.length > 80) history.shift(); }
    function createChild(id: Session) {
      if (!state.children[id]) state.children[id] = { lastSend: state.time, generation: ++state.generations[id], messages: [] };
      return state.children[id]!;
    }

    function render() {
      put("#lite-clock", `t = ${state.time} min`);
      put("#lite-event", state.event);
      const select = find<HTMLSelectElement>("#shared-mode");
      select.value = state.mode;
      select.disabled = state.shared.length > 0;
      put("#shared-rule", state.mode === "normal" ? "Session identity is message data. The example distributes events across shared queues; it does not guarantee session order." : "FIFO topic: messageGroup = sessionId. Each session stays in one shared queue and is processed in order; there is still no child resource or per-session TTL.");
      put("#shared-delivery", state.sharedDelivery);
      put("#lite-delivery", state.liteDelivery);
      put("#lite-count", `Active child channels: ${sessions.filter(id => state.children[id]).length}`);
      for (let q = 0; q < 4; q++) find<HTMLElement>(`#shared-q${q}`).innerHTML = state.shared.filter(m => m.queue === q).map(messageRow).join("") || "<li>Empty</li>";
      for (const id of sessions) {
        const child = state.children[id];
        const worker = id === "481" ? "L1" : "L2";
        put(`#child-status-${id}`, child ? `Generation ${child.generation} · Q0\nIdle: ${state.time - child.lastSend} min / TTL 60 min\n${child.messages.length ? "Since last send" : "Since creation; no send yet"}` : state.generations[id] ? "Expired · child quota released" : "Absent");
        find<HTMLElement>(`#child-status-${id}`).classList.add("whitespace-pre-line");
        find<HTMLElement>(`#child-messages-${id}`).innerHTML = child ? child.messages.map(messageRow).join("") || "<li>Queue empty</li>" : "";
        const subscribe = find<HTMLButtonElement>(`[data-action="subscribe"][data-session="${id}"]`);
        subscribe.textContent = `${state.subscribed[id] ? "Unsubscribe" : "Subscribe"} ${worker} ${state.subscribed[id] ? "from" : "to"} ${id}`;
        put(`#subscription-${id}`, state.subscribed[id] ? `Client selection: session-${id}${child ? "" : " · child expired; a send can recreate it"}.` : "No subscription selected.");
        find<HTMLButtonElement>(`[data-action="consume-lite"][data-session="${id}"]`).disabled = !state.subscribed[id] || !child?.messages.some(m => !m.consumed);
        find<HTMLButtonElement>(`[data-action="send"][data-session="${id}"]`).disabled = state.shared.length >= 12;
      }
      find<HTMLButtonElement>('[data-action="consume-shared"]').disabled = !state.shared.some(m => !m.consumed);
      find<HTMLButtonElement>('[data-action="undo"]').disabled = !history.length;
    }

    find<HTMLSelectElement>("#shared-mode").addEventListener("change", event => {
      save(); state.mode = (event.target as HTMLSelectElement).value as State["mode"];
      state.event = `Selected ${state.mode === "fifo" ? "a FIFO topic with a message group per session" : "normal messages"} for the non-Lite example. Send the same events to compare.`;
      render();
    });
    root.addEventListener("click", event => {
      const button = (event.target as Element).closest<HTMLButtonElement>("button[data-action]");
      if (!button || button.disabled) return;
      const action = button.dataset.action;
      if (action === "reset") { state = initial(); history.length = 0; render(); return; }
      if (action === "undo") { const previous = history.pop(); if (previous) state = previous; render(); return; }
      save();
      const id = button.dataset.session as Session;
      if (action === "send" && sessions.includes(id)) {
        const existed = !!state.children[id];
        const sequence = ++state.sent[id];
        const queue = state.mode === "fifo" ? id === "481" ? 1 : 2 : (state.shared.length + 1) % 4;
        const message: Message = { session: id, sequence, queue, offset: state.shared.filter(m => m.queue === queue).length, consumed: false };
        state.shared.push(message);
        const child = createChild(id);
        child.lastSend = state.time;
        child.messages.push({ ...message, queue: 0, offset: child.messages.length });
        state.event = `${name(message)} stored in both examples. ${existed ? "Restarted" : "Created child and started"} session-${id}'s idle clock. Consumer subscription selections did not change.`;
      } else if (action === "subscribe" && sessions.includes(id)) {
        state.subscribed[id] = !state.subscribed[id];
        if (state.subscribed[id]) {
          const existed = !!state.children[id]; createChild(id);
          state.event = `Subscribed to session-${id}. ${existed ? "Existing child's idle clock is unchanged." : "First subscription created an empty child and started its idle clock."}`;
        } else state.event = `Unsubscribed from session-${id}. This does not delete the child or restart its idle clock.`;
      } else if (action === "time") {
        state.time += 15;
        const expired: string[] = [];
        for (const session of sessions) {
          const child = state.children[session];
          if (child && state.time - child.lastSend > 60) { state.children[session] = null; expired.push(session); }
        }
        state.event = expired.length ? `TTL exceeded: removed child ${expired.join(" and ")} and released its quota. Other children use their own last-send times. Parent topics remain.` : "Clock advanced. No child has exceeded its idle TTL; subscription changes are separate from expiry.";
      } else if (action === "consume-shared") {
        // ponytail: fixed scheduler makes the possible cross-queue reorder reproducible, not a broker prediction.
        const pending = state.shared.filter(m => !m.consumed);
        const message = state.mode === "normal" ? [3, 2, 1, 0].flatMap(q => pending.filter(m => m.queue === q))[0] : pending[0];
        if (message) {
          message.consumed = true;
          const worker = state.mode === "fifo" ? message.session === "481" ? "N1" : "N2" : `N${state.deliveries % 2 + 1}`;
          state.deliveries++;
          state.sharedDelivery = `Q${message.queue}:${message.offset} → ${worker}: ${name(message)} processed and acknowledged.`;
          state.event = `${state.sharedDelivery} ${state.mode === "normal" ? "Different queues have no session-wide ordering guarantee." : "The earlier messages in this session were processed first."}`;
        }
      } else if (action === "consume-lite" && sessions.includes(id)) {
        const message = state.children[id]?.messages.find(m => !m.consumed);
        if (message && state.subscribed[id]) {
          message.consumed = true;
          state.liteDelivery = `session-${id} / Q0:${message.offset} → ${id === "481" ? "L1" : "L2"}: ${name(message)} processed and acknowledged.`;
          state.event = `${state.liteDelivery} Consuming did not restart the last-send clock.`;
        }
      }
      render();
    });
    render();
  }
  setupLiteTopics();
  document.addEventListener("astro:page-load", setupLiteTopics);
</script>
