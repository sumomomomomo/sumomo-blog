---
import BaseLayout from "../../layouts/BaseLayout.astro";

const fieldClass = "flex flex-col gap-1.5";
const fieldTypeClass = "text-xs font-medium text-stone-500 dark:text-slate-400";
const controlClass =
  "w-full rounded-lg border border-stone-300 bg-stone-50 px-3 py-2.5 font-mono text-sm text-stone-800 outline-none focus:border-green-600 focus:ring-2 focus:ring-green-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200";
const objectBoxClass =
  "rounded-xl border-2 border-green-200 bg-green-50/50 p-4 dark:border-green-900 dark:bg-green-950/20";
const nestedBoxClass =
  "rounded-lg border border-stone-300 bg-white p-3 dark:border-slate-700 dark:bg-slate-900";
---

<BaseLayout title="A2A Send Message" activePage="">
  <main class="mx-auto max-w-5xl py-8">
    <header class="mb-8 max-w-3xl">
      <p class="mb-2 font-mono text-sm font-semibold text-green-700 dark:text-green-400">
        A2A Protocol · 3.1.1
      </p>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Send Message</h1>
      <p class="mt-3 text-stone-600 dark:text-slate-300">
        Build a <code>SendMessageRequest</code>, send it from the client agent, and inspect one
        possible server response.
      </p>
    </header>

    <section
      class="rounded-2xl border border-stone-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-6"
      aria-labelledby="flow-heading"
    >
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h2 id="flow-heading" class="text-lg font-semibold">Interaction</h2>
        <p id="flow-status" class="text-sm text-stone-500 dark:text-slate-400" aria-live="polite">
          Ready
        </p>
      </div>

      <svg
        class="h-auto w-full"
        viewBox="0 0 900 280"
        role="img"
        aria-labelledby="diagram-title diagram-description"
      >
        <title id="diagram-title">Send Message interaction</title>
        <desc id="diagram-description">
          A client agent sends a SendMessageRequest to a server agent. The server returns a task,
          direct message, or error.
        </desc>
        <defs>
          <linearGradient id="client-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#86efac"></stop>
            <stop offset="1" stop-color="#16a34a"></stop>
          </linearGradient>
          <linearGradient id="server-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#c4b5fd"></stop>
            <stop offset="1" stop-color="#7c3aed"></stop>
          </linearGradient>
          <marker id="request-head" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
            <path d="M0,0 L0,6 L9,3 z" fill="#16a34a"></path>
          </marker>
          <marker id="response-head" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
            <path d="M0,0 L0,6 L9,3 z" fill="#7c3aed"></path>
          </marker>
        </defs>

        <g aria-label="Client agent">
          <path d="M55 75v125c0 18 38 32 85 32s85-14 85-32V75" fill="url(#client-fill)"></path>
          <ellipse cx="140" cy="75" rx="85" ry="32" fill="#bbf7d0" stroke="#15803d" stroke-width="3"></ellipse>
          <ellipse cx="140" cy="200" rx="85" ry="32" fill="#16a34a" stroke="#15803d" stroke-width="3"></ellipse>
          <text x="140" y="132" text-anchor="middle" class="fill-green-950 text-2xl font-extrabold">Client</text>
          <text x="140" y="157" text-anchor="middle" class="fill-green-900 text-[17px] font-semibold">agent</text>
        </g>

        <g aria-label="Server agent">
          <path d="M675 75v125c0 18 38 32 85 32s85-14 85-32V75" fill="url(#server-fill)"></path>
          <ellipse cx="760" cy="75" rx="85" ry="32" fill="#ddd6fe" stroke="#6d28d9" stroke-width="3"></ellipse>
          <ellipse cx="760" cy="200" rx="85" ry="32" fill="#7c3aed" stroke="#6d28d9" stroke-width="3"></ellipse>
          <text x="760" y="132" text-anchor="middle" class="fill-violet-950 text-2xl font-extrabold">Server</text>
          <text x="760" y="157" text-anchor="middle" class="fill-violet-900 text-[17px] font-semibold">agent</text>
        </g>

        <g id="request-arrow" class="opacity-0" aria-hidden="true">
          <text x="450" y="70" text-anchor="middle" class="fill-current font-mono text-base font-bold">SendMessageRequest</text>
          <line class="[stroke-dasharray:430] [stroke-dashoffset:430]" x1="245" y1="90" x2="650" y2="90" stroke="#16a34a" stroke-width="5" marker-end="url(#request-head)"></line>
        </g>
        <g id="response-arrow" class="opacity-0" aria-hidden="true">
          <text id="response-label" x="450" y="175" text-anchor="middle" class="fill-current font-mono text-base font-bold">Task</text>
          <line class="[stroke-dasharray:430] [stroke-dashoffset:430]" x1="655" y1="150" x2="250" y2="150" stroke="#7c3aed" stroke-width="5" marker-end="url(#response-head)"></line>
        </g>
      </svg>
    </section>

    <form
      id="send-message-form"
      class="mt-6 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-6"
    >
      <div class="mb-5">
        <p class="font-mono text-sm font-semibold text-green-700 dark:text-green-400">3.2.1</p>
        <h2 class="text-xl font-semibold">SendMessageRequest</h2>
      </div>

      <div class={objectBoxClass}>
        <div class="mb-3 flex items-center justify-between gap-3">
          <code class="font-bold text-green-800 dark:text-green-300">SendMessageRequest</code>
          <span class="rounded-full bg-green-100 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wide text-green-700 dark:bg-green-950 dark:text-green-300">
            object
          </span>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          <label class={`${nestedBoxClass} ${fieldClass}`}>
            <span class="font-bold"><code>tenant</code> <small class={fieldTypeClass}>string · optional</small></span>
            <input class={controlClass} id="tenant" name="tenant" type="text" placeholder="acme" />
          </label>

          <fieldset class={`${nestedBoxClass} sm:col-span-2`}>
            <legend class="px-1 font-bold">
              <code>message</code> <small class={fieldTypeClass}>Message · required</small>
            </legend>
            <div class="grid gap-3 sm:grid-cols-2">
              <label class={`${nestedBoxClass} ${fieldClass}`}>
                <span class="font-bold"><code>messageId</code> <small class={fieldTypeClass}>string · required</small></span>
                <input class={controlClass} id="message-id" value="msg-001" required />
              </label>
              <label class={`${nestedBoxClass} ${fieldClass}`}>
                <span class="font-bold"><code>role</code> <small class={fieldTypeClass}>Role · required</small></span>
                <select class={controlClass} id="message-role">
                  <option value="ROLE_USER">ROLE_USER</option>
                </select>
              </label>

              <fieldset class={`${nestedBoxClass} sm:col-span-2`}>
                <legend class="px-1 font-bold">
                  <code>parts</code> <small class={fieldTypeClass}>Part[] · required</small>
                </legend>
                <div class={nestedBoxClass}>
                  <div class="mb-2 flex items-center justify-between gap-2">
                    <code class="text-xs font-bold">[0]</code>
                    <span class="rounded-full bg-stone-100 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wide text-stone-500 dark:bg-slate-800 dark:text-slate-400">
                      Part
                    </span>
                  </div>
                  <div class="grid gap-3 sm:grid-cols-2">
                    <label class={`${nestedBoxClass} ${fieldClass}`}>
                      <span class="font-bold"><code>text</code> <small class={fieldTypeClass}>string · oneof</small></span>
                      <input class={controlClass} id="part-text" value="Plan a weekend in Kyoto" required />
                    </label>
                    <label class={`${nestedBoxClass} ${fieldClass}`}>
                      <span class="font-bold"><code>mediaType</code> <small class={fieldTypeClass}>string · optional</small></span>
                      <input class={controlClass} id="part-media-type" value="text/plain" />
                    </label>
                  </div>
                </div>
              </fieldset>
            </div>
          </fieldset>

          <fieldset class={nestedBoxClass}>
            <legend class="px-1 font-bold">
              <code>configuration</code>
              <small class={fieldTypeClass}>SendMessageConfiguration · optional</small>
            </legend>
            <div class="grid gap-3">
              <label class={`${nestedBoxClass} ${fieldClass}`}>
                <span class="font-bold"><code>acceptedOutputModes[0]</code> <small class={fieldTypeClass}>string</small></span>
                <input class={controlClass} id="output-mode" value="text/plain" />
              </label>
              <label class={`${nestedBoxClass} ${fieldClass}`}>
                <span class="font-bold"><code>returnImmediately</code> <small class={fieldTypeClass}>boolean</small></span>
                <select class={controlClass} id="return-immediately">
                  <option value="false">false</option>
                  <option value="true">true</option>
                </select>
              </label>
            </div>
          </fieldset>

          <fieldset class={nestedBoxClass}>
            <legend class="px-1 font-bold">
              <code>metadata</code> <small class={fieldTypeClass}>object · optional</small>
            </legend>
            <label class={`${nestedBoxClass} ${fieldClass}`}>
              <span class="font-bold"><code>source</code> <small class={fieldTypeClass}>string</small></span>
              <input class={controlClass} id="metadata-source" value="send-message-demo" />
            </label>
          </fieldset>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap items-end gap-4 border-t border-stone-200 pt-5 dark:border-slate-700">
        <label class={`${fieldClass} min-w-52 flex-1 sm:max-w-xs`}>
          <span class="font-bold">Simulated response <small class={fieldTypeClass}>demo control</small></span>
          <select class={controlClass} id="response-kind" name="response-kind">
            <option value="task">Task</option>
            <option value="message">Output (Message)</option>
            <option value="error">Error</option>
          </select>
        </label>
        <button
          id="run-button"
          type="submit"
          class="h-11 rounded-lg bg-green-700 px-6 font-semibold text-white transition hover:bg-green-800 focus:outline-none focus:ring-2 focus:ring-green-600 focus:ring-offset-2 disabled:cursor-wait disabled:opacity-60 dark:bg-green-600 dark:hover:bg-green-500 dark:focus:ring-offset-slate-800"
        >
          Run
        </button>
      </div>

      <p id="form-error" class="mt-3 hidden text-sm font-medium text-red-700 dark:text-red-300" role="alert"></p>
    </form>

    <section
      id="response-panel"
      class="mt-6 hidden rounded-2xl border border-stone-200 bg-stone-50 p-4 text-stone-800 shadow-sm dark:border-slate-700 dark:bg-stone-950 dark:text-slate-100 sm:p-6"
      aria-labelledby="response-heading"
    >
      <div class="mb-3 flex items-center justify-between gap-4">
        <h2 id="response-heading" class="text-lg font-semibold">Exchange payloads</h2>
        <span id="response-badge" class="rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wide"></span>
      </div>
      <div id="response-tree" class="max-h-[40rem] overflow-auto"></div>
    </section>
  </main>
</BaseLayout>

<script>
  import { renderDataTree } from "../../utils/render-data-tree";
  import { randomUuid } from "../../utils/random-uuid";

  type ResponseKind = "task" | "message" | "error";

  interface SendMessageRequest {
    tenant?: string;
    message: {
      messageId: string;
      role: "ROLE_USER";
      parts: { text: string; mediaType?: string }[];
    };
    configuration?: { acceptedOutputModes: string[]; returnImmediately: boolean };
    metadata?: { source: string };
  }

  const wait = (milliseconds: number) =>
    new Promise((resolve) => window.setTimeout(resolve, milliseconds));

  function hideArrow(arrow: SVGGElement) {
    arrow.classList.add("opacity-0");
    arrow.classList.remove("opacity-100");
    arrow.setAttribute("aria-hidden", "true");
  }

  function showArrow(arrow: SVGGElement) {
    arrow.classList.remove("opacity-0");
    arrow.classList.add("opacity-100");
    arrow.setAttribute("aria-hidden", "false");

    const line = arrow.querySelector<SVGLineElement>("line");
    if (!line) return;
    line.getAnimations().forEach((animation) => animation.cancel());
    line.animate([{ strokeDashoffset: "430" }, { strokeDashoffset: "0" }], {
      duration: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 600,
      easing: "ease-out",
      fill: "forwards",
    });
  }

  function responseFor(kind: ResponseKind) {
    if (kind === "task") {
      return {
        task: {
          id: randomUuid(),
          contextId: randomUuid(),
          status: { state: "TASK_STATE_COMPLETED", timestamp: new Date().toISOString() },
        },
      };
    }
    if (kind === "message") {
      return {
        message: {
          contextId: randomUuid(),
          role: "ROLE_AGENT",
          parts: [{ text: "Here is a direct response from the server agent." }],
          messageId: randomUuid(),
        },
      };
    }
    return {
      error: {
        code: "ContentTypeNotSupportedError",
        message: "The requested message content type is not supported by this agent.",
      },
    };
  }

  function setupDemo() {
    const form = document.querySelector<HTMLFormElement>("#send-message-form");
    if (!form || form.dataset.ready) return;
    form.dataset.ready = "true";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = document.querySelector<HTMLButtonElement>("#run-button");
      const error = document.querySelector<HTMLElement>("#form-error");
      const status = document.querySelector<HTMLElement>("#flow-status");
      const requestArrow = document.querySelector<SVGGElement>("#request-arrow");
      const responseArrow = document.querySelector<SVGGElement>("#response-arrow");
      const responseLabel = document.querySelector<SVGTextElement>("#response-label");
      const panel = document.querySelector<HTMLElement>("#response-panel");
      const badge = document.querySelector<HTMLElement>("#response-badge");
      const output = document.querySelector<HTMLElement>("#response-tree");
      const kind = document.querySelector<HTMLSelectElement>("#response-kind")?.value as ResponseKind;

      if (!button || !error || !status || !requestArrow || !responseArrow || !responseLabel || !panel || !badge || !output) return;

      error.classList.add("hidden");
      panel.classList.add("hidden");
      hideArrow(requestArrow);
      hideArrow(responseArrow);

      try {
        const tenant = document.querySelector<HTMLInputElement>("#tenant")?.value.trim();
        const messageId = document.querySelector<HTMLInputElement>("#message-id")!.value.trim();
        const text = document.querySelector<HTMLInputElement>("#part-text")!.value.trim();
        const mediaType = document
          .querySelector<HTMLInputElement>("#part-media-type")!
          .value.trim();
        const outputMode = document.querySelector<HTMLInputElement>("#output-mode")!.value.trim();
        const metadataSource = document
          .querySelector<HTMLInputElement>("#metadata-source")!
          .value.trim();
        if (!messageId || !text) throw new Error("messageId and parts[0].text are required.");
        const request: SendMessageRequest = {
          message: {
            messageId,
            role: "ROLE_USER",
            parts: [{ text, ...(mediaType ? { mediaType } : {}) }],
          },
          ...(tenant ? { tenant } : {}),
          ...(outputMode
            ? {
                configuration: {
                  acceptedOutputModes: [outputMode],
                  returnImmediately:
                    document.querySelector<HTMLSelectElement>("#return-immediately")!.value ===
                    "true",
                },
              }
            : {}),
          ...(metadataSource ? { metadata: { source: metadataSource } } : {}),
        };

        button.disabled = true;
        status.textContent = "Sending request…";
        showArrow(requestArrow);
        await wait(850);

        const labels: Record<ResponseKind, string> = {
          task: "Task",
          message: "Output (Message)",
          error: "Error",
        };
        responseLabel.textContent = labels[kind];
        showArrow(responseArrow);
        status.textContent = `Received ${labels[kind]}`;
        await wait(650);

        renderDataTree(output, { request, response: responseFor(kind) }, "Exchange");
        badge.textContent = labels[kind];
        badge.className = `rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wide ${kind === "error" ? "bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-100" : "bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-100"}`;
        panel.classList.remove("hidden");
      } catch (cause) {
        error.textContent = cause instanceof Error ? cause.message : "Complete the required fields.";
        error.classList.remove("hidden");
        status.textContent = "Request invalid";
      } finally {
        button.disabled = false;
      }
    });
  }

  document.addEventListener("astro:page-load", setupDemo);
</script>
