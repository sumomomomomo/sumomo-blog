---
import BaseLayout from "../../layouts/BaseLayout.astro";

const controlClass =
  "w-full rounded-lg border border-stone-300 bg-stone-50 px-3 py-2.5 font-mono text-sm text-stone-800 outline-none focus:border-green-600 focus:ring-2 focus:ring-green-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200";

const states = [
  ["TASK_STATE_UNSPECIFIED", "No task", "unknown"],
  ["TASK_STATE_SUBMITTED", "Acknowledged", "active"],
  ["TASK_STATE_WORKING", "Processing", "active"],
  ["TASK_STATE_INPUT_REQUIRED", "Needs input", "interrupted"],
  ["TASK_STATE_AUTH_REQUIRED", "Needs auth", "interrupted"],
  ["TASK_STATE_COMPLETED", "Succeeded", "terminal"],
  ["TASK_STATE_FAILED", "Failed", "terminal"],
  ["TASK_STATE_CANCELED", "Canceled", "terminal"],
  ["TASK_STATE_REJECTED", "Rejected", "terminal"],
] as const;
---

<BaseLayout title="A2A Task Lifecycle" activePage="">
  <main id="task-demo" class="mx-auto max-w-5xl py-8">
    <header class="mb-8 max-w-3xl">
      <p class="mb-2 font-mono text-sm font-semibold text-green-700 dark:text-green-400">
        A2A Protocol · 3.1.1 · 3.1.3 · 3.1.5 · 4.1.1 · 4.1.3
      </p>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Task Lifecycle</h1>
      <p class="mt-3 text-stone-600 dark:text-slate-300">
        Create a task, poll it with <code>GetTask</code>, continue an interrupted turn, or
        attempt to cancel it with <code>CancelTask</code>.
      </p>
    </header>

    <section
      class="rounded-2xl border border-stone-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-6"
      aria-labelledby="guide-heading"
    >
      <div class="mb-4">
        <p class="font-mono text-sm font-semibold text-green-700 dark:text-green-400">Guide</p>
        <h2 id="guide-heading" class="text-xl font-semibold">What the controls do</h2>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        <div class="rounded-lg border border-stone-200 bg-stone-50 p-3 dark:border-slate-700 dark:bg-slate-900">
          <p class="font-bold"><code>Send Message</code> <small class="text-xs font-medium text-stone-500 dark:text-slate-400"><span data-spec="sendmessage">SendMessage</span></small></p>
          <p class="mt-1 text-sm text-stone-600 dark:text-slate-300">
            Sends a <code><span data-spec="sendmessagerequest">SendMessageRequest</span></code>
            containing your initial <span data-spec="message">Message</span>. The simulated server
            creates a <span data-spec="task">Task</span> in <code>TASK_STATE_SUBMITTED</code> and
            returns it inside a
            <span data-spec="sendmessageresponse">SendMessageResponse</span>. Note: this demo
            behaves as if <code>return_immediately: true</code> — by default
            <code>SendMessage</code> blocks until the task reaches a terminal or interrupted state
            (3.2.2).
          </p>
        </div>
        <div class="rounded-lg border border-stone-200 bg-stone-50 p-3 dark:border-slate-700 dark:bg-slate-900">
          <p class="font-bold"><code>Server Works on Task</code> <small class="text-xs font-medium text-stone-500 dark:text-slate-400">demo control</small></p>
          <p class="mt-1 text-sm text-stone-600 dark:text-slate-300">
            Simulates the server agent doing work: advancing the
            <span data-spec="task">Task</span> along its lifecycle, possibly producing artifacts or
            a status <span data-spec="message">Message</span>. This is not a protocol operation —
            on a real server, progress happens independently of the client.
          </p>
        </div>
        <div class="rounded-lg border border-stone-200 bg-stone-50 p-3 dark:border-slate-700 dark:bg-slate-900">
          <p class="font-bold"><code>Get Task</code> <small class="text-xs font-medium text-stone-500 dark:text-slate-400"><span data-spec="gettask">GetTask</span></small></p>
          <p class="mt-1 text-sm text-stone-600 dark:text-slate-300">
            Sends a <code><span data-spec="gettaskrequest">GetTaskRequest</span></code> and
            receives the <span data-spec="task">Task</span> directly, exactly as the server
            currently holds it — the state may be unchanged from the last poll.
            <span data-spec="historylength">historyLength?</span> controls how much history comes
            back.
          </p>
        </div>
        <div class="rounded-lg border border-stone-200 bg-stone-50 p-3 dark:border-slate-700 dark:bg-slate-900">
          <p class="font-bold"><code>Cancel Task</code> <small class="text-xs font-medium text-stone-500 dark:text-slate-400"><span data-spec="canceltask">CancelTask</span></small></p>
          <p class="mt-1 text-sm text-stone-600 dark:text-slate-300">
            Sends a <code><span data-spec="canceltaskrequest">CancelTaskRequest</span></code>. The
            server returns the updated <span data-spec="task">Task</span> with
            <span data-spec="state">TaskState</span> of
            <code>TASK_STATE_CANCELED</code>, or an error such as
            <span data-spec="tasknotcancelableerror">TaskNotCancelableError</span> if the task is
            already terminal.
          </p>
        </div>
        <div class="rounded-lg border border-stone-200 bg-stone-50 p-3 dark:border-slate-700 dark:bg-slate-900">
          <p class="font-bold">Reset <small class="text-xs font-medium text-stone-500 dark:text-slate-400">demo control</small></p>
          <p class="mt-1 text-sm text-stone-600 dark:text-slate-300">
            Clears the client's local state and both exchange trees so you can start over. This is
            a demo control, not an A2A protocol operation.
          </p>
        </div>
      </div>

      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <div class="rounded-lg border border-stone-200 bg-stone-50 p-3 dark:border-slate-700 dark:bg-slate-900">
          <p class="font-bold">Current Task</p>
          <p class="mt-1 text-sm text-stone-600 dark:text-slate-300">
            The client's local view of the <span data-spec="task">Task</span> — the latest state it
            has received from the server, including status, artifacts, and history. It can lag the
            server's actual state between polls.
          </p>
        </div>
        <div class="rounded-lg border border-stone-200 bg-stone-50 p-3 dark:border-slate-700 dark:bg-slate-900">
          <p class="font-bold">Last exchange</p>
          <p class="mt-1 text-sm text-stone-600 dark:text-slate-300">
            The most recent request and response, rendered as spec objects: e.g.
            <code><span data-spec="sendmessagerequest">SendMessageRequest</span></code> →
            <span data-spec="sendmessageresponse">SendMessageResponse</span>, or
            <code><span data-spec="gettaskrequest">GetTaskRequest</span></code> →
            <span data-spec="task">Task</span>. Hover any underlined label for its definition.
          </p>
        </div>
      </div>
    </section>

    <section
      class="mt-6 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-6"
      aria-labelledby="exchange-heading"
    >
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h2 id="exchange-heading" class="text-lg font-semibold">Client ↔ server exchange</h2>
        <p id="flow-status" class="text-sm text-stone-500 dark:text-slate-400" aria-live="polite">
          No task yet
        </p>
      </div>

      <svg
        class="h-auto w-full"
        viewBox="0 0 900 260"
        role="img"
        aria-labelledby="diagram-title diagram-description"
      >
        <title id="diagram-title">A2A task operation exchange</title>
        <desc id="diagram-description">
          A client agent sends task operations to a server agent, which returns a Task or an error.
        </desc>
        <defs>
          <linearGradient id="lifecycle-client-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#86efac"></stop>
            <stop offset="1" stop-color="#16a34a"></stop>
          </linearGradient>
          <linearGradient id="lifecycle-server-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#c4b5fd"></stop>
            <stop offset="1" stop-color="#7c3aed"></stop>
          </linearGradient>
          <marker id="lifecycle-request-head" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
            <path d="M0,0 L0,6 L9,3 z" fill="#16a34a"></path>
          </marker>
          <marker id="lifecycle-response-head" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
            <path d="M0,0 L0,6 L9,3 z" fill="#7c3aed"></path>
          </marker>
        </defs>

        <g aria-label="Client agent">
          <path d="M55 65v125c0 18 38 32 85 32s85-14 85-32V65" fill="url(#lifecycle-client-fill)"></path>
          <ellipse cx="140" cy="65" rx="85" ry="32" fill="#bbf7d0" stroke="#15803d" stroke-width="3"></ellipse>
          <ellipse cx="140" cy="190" rx="85" ry="32" fill="#16a34a" stroke="#15803d" stroke-width="3"></ellipse>
          <text x="140" y="122" text-anchor="middle" class="fill-green-950 text-2xl font-extrabold">Client</text>
          <text x="140" y="147" text-anchor="middle" class="fill-green-900 text-[17px] font-semibold">agent</text>
        </g>

        <g aria-label="Server agent">
          <path d="M675 65v125c0 18 38 32 85 32s85-14 85-32V65" fill="url(#lifecycle-server-fill)"></path>
          <ellipse cx="760" cy="65" rx="85" ry="32" fill="#ddd6fe" stroke="#6d28d9" stroke-width="3"></ellipse>
          <ellipse cx="760" cy="190" rx="85" ry="32" fill="#7c3aed" stroke="#6d28d9" stroke-width="3"></ellipse>
          <text x="760" y="122" text-anchor="middle" class="fill-violet-950 text-2xl font-extrabold">Server</text>
          <text x="760" y="147" text-anchor="middle" class="fill-violet-900 text-[17px] font-semibold">agent</text>
        </g>

        <g id="operation-arrow" class="opacity-0" aria-hidden="true">
          <text id="operation-label" x="450" y="58" text-anchor="middle" class="fill-current font-mono text-base font-bold">GetTask</text>
          <line class="[stroke-dasharray:430] [stroke-dashoffset:430]" x1="245" y1="78" x2="650" y2="78" stroke="#16a34a" stroke-width="5" marker-end="url(#lifecycle-request-head)"></line>
        </g>
        <g id="result-arrow" class="opacity-0" aria-hidden="true">
          <text id="result-label" x="450" y="174" text-anchor="middle" class="fill-current font-mono text-base font-bold">Task</text>
          <line class="[stroke-dasharray:430] [stroke-dashoffset:430]" x1="655" y1="150" x2="250" y2="150" stroke="#7c3aed" stroke-width="5" marker-end="url(#lifecycle-response-head)"></line>
        </g>
      </svg>
    </section>

    <section
      class="mt-6 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-6"
      aria-labelledby="states-heading"
    >
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="font-mono text-sm font-semibold text-green-700 dark:text-green-400">4.1.3</p>
          <h2 id="states-heading" class="text-xl font-semibold">TaskState</h2>
        </div>
        <span id="state-badge" class="rounded-full bg-stone-200 px-3 py-1 font-mono text-xs font-bold text-stone-700 dark:bg-slate-700 dark:text-slate-200">
          TASK_STATE_UNSPECIFIED
        </span>
      </div>

      <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {states.map(([state, description, kind]) => (
          <div
            data-task-state={state}
            class="rounded-xl border border-stone-200 bg-stone-50 p-3 transition dark:border-slate-700 dark:bg-slate-900"
          >
            <div class="flex items-center justify-between gap-2">
              <code class="break-all text-xs font-bold">{state.replace("TASK_STATE_", "")}</code>
              <span
                class:list={[
                  "rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide",
                  kind === "terminal" && "bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300",
                  kind === "interrupted" && "bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300",
                  kind === "active" && "bg-green-100 text-green-700 dark:bg-green-950 dark:text-green-300",
                  kind === "unknown" && "bg-stone-200 text-stone-600 dark:bg-slate-700 dark:text-slate-300",
                ]}
              >
                {kind}
              </span>
            </div>
            <p class="mt-1 text-xs text-stone-500 dark:text-slate-400">{description}</p>
          </div>
        ))}
      </div>

      <p class="mt-4 text-xs text-stone-500 dark:text-slate-400">
        <span class="mr-4 inline-flex items-center gap-1.5">
          <span class="inline-block h-3 w-3 rounded border-2 border-green-600 bg-green-50 dark:border-green-500 dark:bg-green-950/40"></span>
          green border = state as seen by client
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="inline-block h-3 w-3 rounded bg-stone-200 dark:bg-slate-600"></span>
          darker shade = true state of task as seen by server
        </span>
      </p>
    </section>

    <section
      class="mt-6 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-6"
      aria-labelledby="controls-heading"
    >
      <div class="mb-5">
        <p class="font-mono text-sm font-semibold text-green-700 dark:text-green-400">Simulation</p>
        <h2 id="controls-heading" class="text-xl font-semibold">Drive the lifecycle</h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <label class="flex flex-col gap-1.5 sm:col-span-2">
          <span class="font-bold">Initial message <small class="text-xs font-medium text-stone-500 dark:text-slate-400"><span data-spec="message">Message</span>.parts[0].text</small></span>
          <input id="initial-message" class={controlClass} value="Plan a weekend in Kyoto" />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="font-bold">Server path <small class="text-xs font-medium text-stone-500 dark:text-slate-400">demo control</small></span>
          <select id="server-path" class={controlClass}>
            <option value="complete">Complete</option>
            <option value="input">Require input</option>
            <option value="auth">Require auth</option>
            <option value="fail">Fail</option>
            <option value="reject">Reject</option>
          </select>
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="font-bold"><code><span data-spec="historylength">historyLength</span></code> <small class="text-xs font-medium text-stone-500 dark:text-slate-400">integer?</small></span>
          <input id="history-length" class={controlClass} type="number" min="0" placeholder="Unlimited" value="3" />
        </label>
      </div>


      <form id="follow-up-form" class="mt-5 hidden rounded-xl border border-amber-300 bg-amber-50 p-4 dark:border-amber-800 dark:bg-amber-950/40">
        <div id="follow-up-input">
          <label class="flex flex-col gap-1.5">
            <span id="follow-up-title" class="font-bold text-amber-900 dark:text-amber-200">The server needs more input</span>
            <span class="text-sm text-amber-800 dark:text-amber-300">The follow-up Message reuses this task’s <code>taskId</code> and <code>contextId</code>.</span>
            <input id="follow-up-message" class={controlClass} value="Two days, focused on food and temples" />
          </label>
          <button type="submit" class="mt-3 rounded-lg bg-amber-700 px-4 py-2.5 font-semibold text-white transition hover:bg-amber-800 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2 dark:bg-amber-600 dark:hover:bg-amber-500 dark:focus:ring-offset-amber-950">
            Send follow-up
          </button>
        </div>
        <div id="auth-options" class="hidden">
          <p id="auth-title" class="font-bold text-amber-900 dark:text-amber-200">The server needs authorization</p>
          <p class="mt-1 text-sm text-amber-800 dark:text-amber-300">
            Per 7.6.2, the client may send a Message to negotiate the request, or fulfill the
            authorization out-of-band — in which case the server resumes on its own.
          </p>
          <div id="auth-inband" class="hidden">
            <label class="mt-3 flex flex-col gap-1.5">
              <span class="text-sm font-semibold text-amber-900 dark:text-amber-200">Option 1: in-band — send a credential Message</span>
              <input id="auth-credential" class={controlClass} value="Bearer eyJhbGciOi..." />
            </label>
            <button id="auth-send" type="button" class="mt-2 rounded-lg bg-amber-700 px-4 py-2.5 font-semibold text-white transition hover:bg-amber-800 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2 dark:bg-amber-600 dark:hover:bg-amber-500 dark:focus:ring-offset-amber-950">
              Send credential Message
            </button>
          </div>
          <div class="mt-4 border-t border-amber-300 pt-3 dark:border-amber-800">
            <span class="text-sm font-semibold text-amber-900 dark:text-amber-200">Option 2: out-of-band — the agent receives the credential directly</span>
            <button id="auth-oob" type="button" class="mt-2 block rounded-lg border border-amber-700 bg-transparent px-4 py-2.5 font-semibold text-amber-800 transition hover:bg-amber-100 focus:outline-none focus:ring-2 focus:ring-amber-600 dark:border-amber-600 dark:text-amber-200 dark:hover:bg-amber-900/40">
              Simulate out-of-band authorization
            </button>
            <p class="mt-1 text-xs text-amber-700 dark:text-amber-400">No client Message is sent; the server continues by itself. Poll Get Task to discover the new state.</p>
          </div>
        </div>
      </form>
    </section>

    <div
      id="floating-actions"
      class="fixed bottom-4 left-4 z-40 flex w-max max-w-[calc(100vw-1rem)] flex-wrap gap-3 rounded-xl border border-stone-200 bg-white/95 p-3 shadow-lg backdrop-blur cursor-move [&_button]:cursor-pointer dark:border-slate-700 dark:bg-slate-900/95"
    >
      <button id="create-task" type="button" class="rounded-lg bg-green-700 px-4 py-2.5 font-semibold text-white transition hover:bg-green-800 focus:outline-none focus:ring-2 focus:ring-green-600 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40 dark:bg-green-600 dark:hover:bg-green-500 dark:focus:ring-offset-slate-800">
        Send Message
      </button>
      <button id="server-works" type="button" disabled class="rounded-lg bg-amber-700 px-4 py-2.5 font-semibold text-white transition hover:bg-amber-800 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40 dark:bg-amber-600 dark:hover:bg-amber-500 dark:focus:ring-offset-slate-800">
        Server Works on Task
      </button>
      <button id="get-task" type="button" disabled class="rounded-lg bg-violet-700 px-4 py-2.5 font-semibold text-white transition hover:bg-violet-800 focus:outline-none focus:ring-2 focus:ring-violet-600 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40 dark:bg-violet-600 dark:hover:bg-violet-500 dark:focus:ring-offset-slate-800">
        Get Task
      </button>
      <button id="cancel-task" type="button" class="rounded-lg border border-red-300 bg-white px-4 py-2.5 font-semibold text-red-700 transition hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 dark:border-red-800 dark:bg-slate-900 dark:text-red-300 dark:hover:bg-red-950 dark:focus:ring-offset-slate-800">
        Cancel Task
      </button>
      <button id="reset-task" type="button" class="rounded-lg border border-stone-300 bg-white px-4 py-2.5 font-semibold text-stone-700 transition hover:bg-stone-100 focus:outline-none focus:ring-2 focus:ring-stone-400 focus:ring-offset-2 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-700 dark:focus:ring-offset-slate-800">
        Reset
      </button>
    </div>

    <div class="mt-6 flex flex-col gap-6">
      <section class="min-w-0 rounded-2xl border border-stone-200 bg-stone-50 p-4 text-stone-800 shadow-sm dark:border-slate-700 dark:bg-stone-950 dark:text-slate-100 sm:p-6" aria-labelledby="task-heading">
        <div class="mb-3 flex items-center justify-between gap-3">
          <h2 id="task-heading" class="text-lg font-semibold">Current Task</h2>
          <span class="font-mono text-xs text-stone-500 dark:text-slate-400">id · contextId · status · artifacts · history</span>
        </div>
        <div id="task-tree" class="max-h-[32rem] overflow-auto font-mono text-sm text-slate-400">
          No task yet.
        </div>
      </section>

      <section class="min-w-0 rounded-2xl border border-stone-200 bg-stone-50 p-4 text-stone-800 shadow-sm dark:border-slate-700 dark:bg-stone-950 dark:text-slate-100 sm:p-6" aria-labelledby="payload-heading">
        <div class="mb-3 flex items-center justify-between gap-3">
          <h2 id="payload-heading" class="text-lg font-semibold">Last exchange</h2>
          <span id="exchange-badge" class="rounded-full bg-stone-200 px-3 py-1 font-mono text-xs font-bold text-stone-600 dark:bg-slate-800 dark:text-slate-300">None</span>
        </div>
        <div class="grid gap-4 lg:grid-cols-2">
          <section class="min-w-0">
            <p class="mb-2 font-mono text-xs font-bold uppercase tracking-wide text-stone-500 dark:text-slate-400">Client → Server</p>
            <div id="request-tree" class="max-h-[32rem] overflow-auto font-mono text-sm text-slate-400">
              Create a task to begin.
            </div>
          </section>
          <section class="min-w-0">
            <p class="mb-2 font-mono text-xs font-bold uppercase tracking-wide text-stone-500 dark:text-slate-400">Server → Client</p>
            <div id="response-tree" class="max-h-[32rem] overflow-auto font-mono text-sm text-slate-400">
              Create a task to begin.
            </div>
          </section>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import {
    clearSpecPopovers,
    renderDataTree,
    setupSpecPopovers,
  } from "../../utils/render-data-tree";
  import { randomUuid } from "../../utils/random-uuid";

  type TaskState =
    | "TASK_STATE_SUBMITTED"
    | "TASK_STATE_WORKING"
    | "TASK_STATE_COMPLETED"
    | "TASK_STATE_FAILED"
    | "TASK_STATE_CANCELED"
    | "TASK_STATE_INPUT_REQUIRED"
    | "TASK_STATE_REJECTED"
    | "TASK_STATE_AUTH_REQUIRED";
  type ServerPath = "complete" | "input" | "auth" | "fail" | "reject";

  interface A2AMessage {
    messageId: string;
    contextId: string;
    taskId: string;
    role: "ROLE_USER" | "ROLE_AGENT";
    parts: { text: string }[];
  }

  interface Task {
    id: string;
    contextId: string;
    status: { state: TaskState; timestamp: string; message?: A2AMessage };
    artifacts?: { artifactId: string; name: string; parts: { text: string }[] }[];
    history: A2AMessage[];
  }

  const terminalStates = new Set<TaskState>([
    "TASK_STATE_COMPLETED",
    "TASK_STATE_FAILED",
    "TASK_STATE_CANCELED",
    "TASK_STATE_REJECTED",
  ]);

  function setupTaskDemo() {
    const root = document.querySelector<HTMLElement>("#task-demo");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "true";

    const find = <T extends Element>(selector: string) => root.querySelector<T>(selector)!;
    const createButton = find<HTMLButtonElement>("#create-task");
    const getButton = find<HTMLButtonElement>("#get-task");
    const serverWorksButton = find<HTMLButtonElement>("#server-works");
    const taskOutput = find<HTMLElement>("#task-tree");
    const requestOutput = find<HTMLElement>("#request-tree");
    const responseOutput = find<HTMLElement>("#response-tree");
    const stateBadge = find<HTMLElement>("#state-badge");
    const exchangeBadge = find<HTMLElement>("#exchange-badge");
    const flowStatus = find<HTMLElement>("#flow-status");
    const followUpForm = find<HTMLFormElement>("#follow-up-form");
    const stateNodes = root.querySelectorAll<HTMLElement>("[data-task-state]");
    let serverTask: Task | undefined;
    let task: Task | undefined;
    let serverPath: ServerPath = "complete";
    const message = (role: A2AMessage["role"], text: string): A2AMessage => ({
      messageId: randomUuid(),
      contextId: serverTask!.contextId,
      taskId: serverTask!.id,
      role,
      parts: [{ text }],
    });

    function showArrow(operation: string, result: "Task" | "Error") {
      const operationArrow = find<SVGGElement>("#operation-arrow");
      const resultArrow = find<SVGGElement>("#result-arrow");
      find<SVGTextElement>("#operation-label").textContent = operation;
      find<SVGTextElement>("#result-label").textContent = result;

      for (const arrow of [operationArrow, resultArrow]) {
        arrow.classList.remove("opacity-0");
        arrow.setAttribute("aria-hidden", "false");
        const line = arrow.querySelector<SVGLineElement>("line")!;
        line.getAnimations().forEach((animation) => animation.cancel());
        line.animate([{ strokeDashoffset: "430" }, { strokeDashoffset: "0" }], {
          duration: matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 500,
          easing: "ease-out",
          fill: "forwards",
        });
      }
    }

    function setOperation(
      operation: string,
      requestType: string,
      request: object,
      responseType: string,
      response: object,
      result: "Task" | "Error" = "Task",
    ) {
      showArrow(operation, result);
      exchangeBadge.textContent = operation;
      renderDataTree(requestOutput, request, requestType);
      renderDataTree(responseOutput, response, responseType);
      flowStatus.textContent = `${operation} → ${result}`;
    }

    function setState(state: TaskState, text?: string) {
      if (!serverTask) return;
      serverTask.status = {
        state,
        timestamp: new Date().toISOString(),
        ...(text ? { message: message("ROLE_AGENT", text) } : {}),
      };
      if (text) serverTask.history.push(serverTask.status.message!);
    }

    function taskForGet(historyLength?: number): Omit<Task, "history"> & { history?: A2AMessage[] } {
      const { history, ...withoutHistory } = structuredClone(serverTask!);
      const snapshot: Omit<Task, "history"> & { history?: A2AMessage[] } = withoutHistory;
      if (historyLength === undefined) snapshot.history = history;
      else if (historyLength > 0) snapshot.history = history.slice(-historyLength);
      return snapshot;
    }

    const floatingBar = find<HTMLElement>("#floating-actions");
    let dragState: { startX: number; startY: number; origLeft: number; origTop: number } | null = null;
    floatingBar.addEventListener("pointerdown", (event) => {
      if ((event.target as HTMLElement).closest("button")) return;
      const rect = floatingBar.getBoundingClientRect();
      dragState = { startX: event.clientX, startY: event.clientY, origLeft: rect.left, origTop: rect.top };
      floatingBar.style.bottom = "auto";
      floatingBar.style.left = `${rect.left}px`;
      floatingBar.style.top = `${rect.top}px`;
      floatingBar.style.cursor = "grabbing";
      floatingBar.style.touchAction = "none";
      floatingBar.setPointerCapture(event.pointerId);
    });
    floatingBar.addEventListener("pointermove", (event) => {
      if (!dragState) return;
      const left = dragState.origLeft + (event.clientX - dragState.startX);
      const top = dragState.origTop + (event.clientY - dragState.startY);
      floatingBar.style.left = `${Math.max(8, Math.min(left, window.innerWidth - floatingBar.offsetWidth - 8))}px`;
      floatingBar.style.top = `${Math.max(8, Math.min(top, window.innerHeight - floatingBar.offsetHeight - 8))}px`;
    });
    const endDrag = (event: PointerEvent) => {
      if (!dragState) return;
      dragState = null;
      floatingBar.style.cursor = "";
      floatingBar.style.touchAction = "";
      try {
        floatingBar.releasePointerCapture(event.pointerId);
      } catch {
        // Pointer capture may already be released.
      }
    };
    floatingBar.addEventListener("pointerup", endDrag);
    floatingBar.addEventListener("pointercancel", endDrag);
    function render() {
      const state = task?.status.state ?? "TASK_STATE_UNSPECIFIED";
      if (task) renderDataTree(taskOutput, task, "Task");
      else taskOutput.textContent = "No task yet.";
      stateBadge.textContent = state;
      flowStatus.textContent = task ? `${state.replace("TASK_STATE_", "")} · ${task.id.slice(0, 8)}` : "No task yet";
      createButton.disabled = Boolean(task);
      const serverState = serverTask?.status.state;
      serverWorksButton.disabled =
        !serverTask ||
        terminalStates.has(serverState as TaskState) ||
        serverState === "TASK_STATE_INPUT_REQUIRED" ||
        serverState === "TASK_STATE_AUTH_REQUIRED";
      getButton.disabled = !task;
      const clientInterrupted = state === "TASK_STATE_INPUT_REQUIRED" || state === "TASK_STATE_AUTH_REQUIRED";
      followUpForm.classList.toggle(
        "hidden",
        !clientInterrupted && serverState !== "TASK_STATE_AUTH_REQUIRED",
      );
      find<HTMLElement>("#follow-up-input").classList.toggle("hidden", state !== "TASK_STATE_INPUT_REQUIRED");
      find<HTMLElement>("#auth-options").classList.toggle(
        "hidden",
        serverState !== "TASK_STATE_AUTH_REQUIRED",
      );
      find<HTMLElement>("#auth-inband").classList.toggle("hidden", state !== "TASK_STATE_AUTH_REQUIRED");
      find<HTMLElement>("#follow-up-title").textContent =
        state === "TASK_STATE_AUTH_REQUIRED" ? "The server needs authorization" : "The server needs more input";

      stateNodes.forEach((node) => {
        const active = node.dataset.taskState === state;
        node.classList.toggle("border-green-600", active);
        node.classList.toggle("bg-green-50", active);
        node.classList.toggle("ring-2", active);
        node.classList.toggle("ring-green-200", active);
        node.classList.toggle("dark:border-green-500", active);
        node.classList.toggle("dark:bg-green-950/40", active);
        const serverActive = node.dataset.taskState === serverTask?.status.state;
        node.classList.toggle("bg-stone-200", serverActive);
        node.classList.toggle("dark:bg-slate-700", serverActive);
      });
    }

    createButton.addEventListener("click", () => {
      const text = find<HTMLInputElement>("#initial-message").value.trim();
      if (!text) return find<HTMLInputElement>("#initial-message").focus();
      serverPath = find<HTMLSelectElement>("#server-path").value as ServerPath;
      serverTask = {
        id: randomUuid(),
        contextId: randomUuid(),
        status: { state: "TASK_STATE_SUBMITTED", timestamp: new Date().toISOString() },
        history: [],
      };
      const initialMessage = message("ROLE_USER", text);
      serverTask.history.push(initialMessage);
      task = structuredClone(serverTask);
      render();
      setOperation(
        "SendMessage",
        "SendMessageRequest",
        { message: initialMessage },
        "SendMessageResponse",
        { task: serverTask },
      );
    });

    serverWorksButton.addEventListener("click", () => {
      if (!serverTask) return;
      serverPath = find<HTMLSelectElement>("#server-path").value as ServerPath;
      if (serverTask.status.state === "TASK_STATE_SUBMITTED") {
        if (serverPath === "reject") setState("TASK_STATE_REJECTED", "The agent declined this task.");
        else setState("TASK_STATE_WORKING", "The agent is processing the request.");
      } else if (serverTask.status.state === "TASK_STATE_WORKING") {
        if (serverPath === "input") {
          setState("TASK_STATE_INPUT_REQUIRED", "How many days should the itinerary cover?");
        } else if (serverPath === "auth") {
          setState("TASK_STATE_AUTH_REQUIRED", "Authorization is required before continuing.");
        } else if (serverPath === "fail") {
          setState("TASK_STATE_FAILED", "The agent could not complete the task.");
        } else {
          serverTask.artifacts = [{
            artifactId: randomUuid(),
            name: "Kyoto itinerary",
            parts: [{ text: "Day 1: Higashiyama and Gion. Day 2: Arashiyama and Nishiki Market." }],
          }];
          setState("TASK_STATE_COMPLETED");
        }
      }
      render();
    });

    getButton.addEventListener("click", () => {
      if (!serverTask) return;
      const rawLength = find<HTMLInputElement>("#history-length").value;
      const historyLength = rawLength === "" ? undefined : Number(rawLength);
      const request = {
        id: serverTask.id,
        ...(historyLength === undefined ? {} : { historyLength }),
      };
      const snapshot = taskForGet(historyLength);
      task = structuredClone(snapshot) as Task;
      render();
      setOperation("GetTask", "GetTaskRequest", request, "Task", snapshot);
    });

    find<HTMLButtonElement>("#cancel-task").addEventListener("click", () => {
      const request = {
        id: task?.id ?? "missing-task-id",
        metadata: { reason: "user_request" },
      };
      if (!serverTask) {
        setOperation("CancelTask", "CancelTaskRequest", request, "Error", { code: "TaskNotFoundError", message: "The task does not exist." }, "Error");
      } else if (terminalStates.has(serverTask.status.state)) {
        setOperation("CancelTask", "CancelTaskRequest", request, "Error", { code: "TaskNotCancelableError", message: `A task in ${serverTask.status.state} cannot be canceled.` }, "Error");
      } else {
        setState("TASK_STATE_CANCELED");
        task = structuredClone(serverTask);
        render();
        setOperation("CancelTask", "CancelTaskRequest", request, "Task", serverTask);
      }
    });

    const resumeServer = (statusText: string, syncClient: boolean) => {
      serverPath = "complete";
      setState("TASK_STATE_WORKING", statusText);
      if (syncClient) task = structuredClone(serverTask!);
      render();
    };

    followUpForm.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!serverTask || serverTask.status.state !== "TASK_STATE_INPUT_REQUIRED") return;
      const text = find<HTMLInputElement>("#follow-up-message").value.trim();
      if (!text) return find<HTMLInputElement>("#follow-up-message").focus();
      const followUp = message("ROLE_USER", text);
      serverTask.history.push(followUp);
      resumeServer("The agent resumed work with the new input.", true);
      setOperation(
        "SendMessage",
        "SendMessageRequest",
        { message: followUp },
        "SendMessageResponse",
        { task: serverTask },
      );
    });

    find<HTMLButtonElement>("#auth-send").addEventListener("click", () => {
      if (!serverTask || serverTask.status.state !== "TASK_STATE_AUTH_REQUIRED") return;
      const credential = find<HTMLInputElement>("#auth-credential").value.trim();
      if (!credential) return find<HTMLInputElement>("#auth-credential").focus();
      const followUp = message("ROLE_USER", `Credential: ${credential}`);
      serverTask.history.push(followUp);
      resumeServer("The agent received the credential and resumed work.", true);
      setOperation(
        "SendMessage",
        "SendMessageRequest",
        { message: followUp },
        "SendMessageResponse",
        { task: serverTask },
      );
    });

    find<HTMLButtonElement>("#auth-oob").addEventListener("click", () => {
      if (!serverTask || serverTask.status.state !== "TASK_STATE_AUTH_REQUIRED") return;
      resumeServer("The agent received the credential out-of-band and resumed work.", false);
      flowStatus.textContent = "Out-of-band authorization received — poll Get Task to discover the new state";
    });

    find<HTMLButtonElement>("#reset-task").addEventListener("click", () => {
      serverTask = undefined;
      task = undefined;
      clearSpecPopovers();
      exchangeBadge.textContent = "None";
      requestOutput.textContent = "Create a task to begin.";
      responseOutput.textContent = "Create a task to begin.";
      for (const arrow of [find("#operation-arrow"), find("#result-arrow")]) {
        arrow.classList.add("opacity-0");
        arrow.setAttribute("aria-hidden", "true");
      }
      render();
    });

    setupSpecPopovers(root);
    render();
  }

  document.addEventListener("astro:page-load", setupTaskDemo);
</script>
