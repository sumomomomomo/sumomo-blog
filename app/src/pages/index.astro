---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  title?: string;
  cdnUrl?: string;
}

const { title = "Sumomo Horse", cdnUrl = "https://cdn.sumomo.horse/misc/unsu-true.jpg" } =
  Astro.props;
---

<BaseLayout title={title} activePage="/">
	<h1 class="text-2xl font-bold my-4">Under Construction (Astro Edition)</h1>
	   <img src={cdnUrl} alt="Seiun Sky" width="256" height="256" />
	<br>
	<a class="text-green-700 dark:text-green-400 hover:text-green-800 dark:hover:text-green-500" href="https://github.com/sumomomomomo/sumomo-blog">Link to this blog's github repo</a>
</BaseLayout>